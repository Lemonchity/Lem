local Library = {}

local Theme = {  
MainBg = Color3.fromRGB(15, 15, 20),  
SidebarBg = Color3.fromRGB(20, 20, 25),  
Accent = Color3.fromRGB(0, 255, 150),  
TextColor = Color3.fromRGB(255, 255, 255),  
SectionBg = Color3.fromRGB(25, 25, 30),  
ButtonColor = Color3.fromRGB(35, 35, 40),  
Font = Enum.Font.Arcade,  
Rounding = 4,  
TextS = 18  
}

function Library.Create(WindowName)  
local ScreenGui = Instance.new("ScreenGui")  
ScreenGui.Name = "ArcadeGridHub_Final"  
ScreenGui.Parent = game:GetService("CoreGui")

local MainFrame = Instance.new("Frame")  
MainFrame.Size = UDim2.new(0, 750, 0, 450)  
MainFrame.Position = UDim2.new(0.5, -375, 0.5, -225)  
MainFrame.BackgroundColor3 = Theme.MainBg  
MainFrame.BorderSizePixel = 0  
MainFrame.Parent = ScreenGui  
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, Theme.Rounding)

local Title = Instance.new("TextLabel")  
Title.Size = UDim2.new(1, 0, 0, 35)  
Title.BackgroundColor3 = Theme.SidebarBg  
Title.Text = "  " .. WindowName .. ""  
Title.TextColor3 = Theme.Accent  
Title.Font = Theme.Font  
Title.TextSize = 18  
Title.TextXAlignment = Enum.TextXAlignment.Left  
Title.Parent = MainFrame  
Instance.new("UICorner", Title).CornerRadius = UDim.new(0, Theme.Rounding)

local Sidebar = Instance.new("Frame")  
Sidebar.Size = UDim2.new(0, 150, 1, -35)  
Sidebar.Position = UDim2.new(0, 0, 0, 35)  
Sidebar.BackgroundColor3 = Theme.SidebarBg  
Sidebar.BorderSizePixel = 0  
Sidebar.Parent = MainFrame

local TabList = Instance.new("UIListLayout")  
TabList.Padding = UDim.new(0, 2)  
TabList.Parent = Sidebar

local PageContainer = Instance.new("Frame")  
PageContainer.Size = UDim2.new(1, -150, 1, -35)  
PageContainer.Position = UDim2.new(0, 150, 0, 35)  
PageContainer.BackgroundTransparency = 1  
PageContainer.Parent = MainFrame

local UIS = game:GetService("UserInputService")  
UIS.InputBegan:Connect(function(input, processed)  
    if not processed and input.KeyCode == Enum.KeyCode.RightControl then  
        MainFrame.Visible = not MainFrame.Visible  
    end  
end)

local dragging, dragStart, startPos  
Title.InputBegan:Connect(function(input)  
if input.UserInputType == Enum.UserInputType.MouseButton1 then  
dragging = true; dragStart = input.Position; startPos = MainFrame.Position  
end  
end)  
UIS.InputChanged:Connect(function(input)  
if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then  
local delta = input.Position - dragStart  
MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)  
end  
end)  
UIS.InputEnded:Connect(function(input)  
if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end  
end)

local self_tabs = {}  
local Hub = {}

function Hub:AddTab(TabName, ColumnCount)  
local ColumnCount = ColumnCount or 1  
local TabBtn = Instance.new("TextButton")  
TabBtn.Size = UDim2.new(1, 0, 0, 35)  
TabBtn.BackgroundColor3 = Theme.SidebarBg  
TabBtn.Text = TabName  
TabBtn.TextColor3 = Theme.TextColor  
TabBtn.Font = Theme.Font  
TabBtn.TextSize = 14  
TabBtn.Parent = Sidebar

local Page = Instance.new("ScrollingFrame")  
Page.Size = UDim2.new(1, 0, 1, 0)  
Page.BackgroundTransparency = 1  
Page.Visible = false  
Page.ScrollBarThickness = 2  
Page.Parent = PageContainer

local Grid = Instance.new("Frame")  
Grid.Size = UDim2.new(1, -20, 1, 0)  
Grid.Position = UDim2.new(0, 10, 0, 0)  
Grid.BackgroundTransparency = 1  
Grid.Parent = Page

local UIGrid = Instance.new("UIGridLayout", Grid)  
UIGrid.FillDirection = Enum.FillDirection.Horizontal  
UIGrid.SortOrder = Enum.SortOrder.LayoutOrder  
UIGrid.CellSize = UDim2.new(1 / ColumnCount, -10, 0, 0)  
UIGrid.CellPadding = UDim2.new(0, 10, 0, 0)

local columns = {}  
for i = 1, ColumnCount do  
local col = Instance.new("Frame")  
col.Size = UDim2.new(1, 0, 0, 0)  
col.BackgroundTransparency = 1  
col.Parent = Grid  
Instance.new("UIListLayout", col).Padding = UDim.new(0, 8)  
table.insert(columns, col)  
end

TabBtn.MouseButton1Click:Connect(function()  
for _, t in pairs(self_tabs) do  
t.Btn.BackgroundColor3 = Theme.SidebarBg  
t.Btn.TextColor3 = Theme.TextColor  
t.Page.Visible = false  
end  
TabBtn.BackgroundColor3 = Theme.ButtonColor  
TabBtn.TextColor3 = Theme.Accent  
Page.Visible = true  
end)

local tabData = {Btn = TabBtn, Page = Page}  
table.insert(self_tabs, tabData)  
if #self_tabs == 1 then  
Page.Visible = true  
TabBtn.BackgroundColor3 = Theme.ButtonColor  
TabBtn.TextColor3 = Theme.Accent  
end

local TabObj = { Columns = columns }

function TabObj:AddComponent(Text, Type, ColumnIndex, Settings, Callback)  
local colIdx = ColumnIndex or 1  
local target = columns[colIdx] or columns[1]  
local Element = nil

if Type == "Toggle" then  
local state = Settings.Default or false  
Element = Instance.new("TextButton")  
Element.Size = UDim2.new(1, 0, 0, 40)  
Element.BackgroundColor3 = state and Theme.Accent or Theme.ButtonColor  
Element.Text = Text .. " ["..(state and "ON" or "OFF").."] "  
Element.TextColor3 = state and Color3.new(0,0,0) or Theme.TextColor  
Element.Font = Theme.Font  
Element.TextSize = Theme.TextS  
Instance.new("UICorner", Element)  
Element.MouseButton1Click:Connect(function()  
state = not state  
Element.BackgroundColor3 = state and Theme.Accent or Theme.ButtonColor  
Element.TextColor3 = state and Color3.new(0,0,0) or Theme.TextColor  
Element.Text = Text .. " ["..(state and "ON" or "OFF").."] "  
Callback(state)  
end)  
elseif Type == "Button" then  
Element = Instance.new("TextButton")  
Element.Size = UDim2.new(1, 0, 0, 40)  
Element.BackgroundColor3 = Theme.ButtonColor  
Element.Text = Text  
Element.TextColor3 = Theme.TextColor  
Element.Font = Theme.Font  
Element.TextSize = Theme.TextS  
Instance.new("UICorner", Element)  
Element.MouseButton1Click:Connect(Callback)  
elseif Type == "Slider" then  
local min, max = Settings.Min or 0, Settings.Max or 100  
local def = Settings.Default or 50  
local frame = Instance.new("Frame")  
frame.Size = UDim2.new(1, 0, 0, 55)  
frame.BackgroundColor3 = Theme.ButtonColor  
Instance.new("UICorner", frame)  
local label = Instance.new("TextLabel")  
label.Size = UDim2.new(1, 0, 0, 25)  
label.BackgroundTransparency = 1  
label.Text = Text .. " : " .. def  
label.TextColor3 = Theme.TextColor  
label.Font = Theme.Font  
label.TextSize = Theme.TextS  
label.Parent = frame  
local bar = Instance.new("Frame")  
bar.Size = UDim2.new(0.8, 0, 0, 10)  
bar.Position = UDim2.new(0.1, 0, 0.6, 0)  
bar.BackgroundColor3 = Color3.fromRGB(10, 10, 15)  
bar.Parent = frame  
Instance.new("UICorner", bar)  
local fill = Instance.new("Frame")  
fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)  
fill.BackgroundColor3 = Theme.Accent  
fill.Parent = bar  
Instance.new("UICorner", fill)  
local draggingS = false  
bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingS = true end end)  
UIS.InputChanged:Connect(function(i)  
if draggingS and i.UserInputType == Enum.UserInputType.MouseMovement then  
local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)  
fill.Size = UDim2.new(rel, 0, 1, 0)  
local val = math.floor(min + (max - min) * rel)  
label.Text = Text .. " : " .. val  
Callback(val)  
end  
end)  
UIS.InputEnded:Connect(function(i)  
if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingS = false end  
end)  
Element = frame  
end

if Element then  
Element.Parent = target  
end  
return Element  
end

return TabObj  
end

return Hub  
end

return Library  
