    function WindowObj:AddConfigManager(folderName)
        folderName = folderName or "NeverloseConfigs"
        if makefolder and not isfolder(folderName) then
            makefolder(folderName)
        end

        self:AddSection({Name = "Configuration"})
        local ConfTab = self:AddTab({Name = "Configs & Theme", Icon = "settings"})

        local LeftBox = ConfTab:AddGroupbox({Name = "Config Manager (JSON)", Side = "Left"})
        local RightBox = ConfTab:AddGroupbox({Name = "UI Theme Settings", Side = "Right"})

        local configName = "default"
        local jsonPreview = ""

        LeftBox:Textbox({
            Name = "Config Name",
            Default = "default",
            Flag = "_ConfigName",
            Callback = function(v) configName = v end
        })

        local function ExportJSON()
            local data = {
                Flags = {},
                Theme = {}
            }
            for k, v in pairs(Library.Flags) do
                if typeof(v) == "Color3" then
                    data.Flags[k] = {Type = "Color3", Hex = v:ToHex()}
                elseif typeof(v) ~= "Instance" then
                    data.Flags[k] = v
                end
            end
            for tKey, col in pairs(Library.Theme) do
                data.Theme[tKey] = col:ToHex()
            end
            return HttpService:JSONEncode(data)
        end

        local function ImportJSON(rawJson)
            local ok, decoded = pcall(function() return HttpService:JSONDecode(rawJson) end)
            if not ok or type(decoded) ~= "table" then
                Library:Notify({Title = "Config Error", Text = "Invalid JSON format!", Duration = 3})
                return
            end

            if decoded.Theme then
                for tKey, hex in pairs(decoded.Theme) do
                    if Library.Theme[tKey] then
                        Library.Theme[tKey] = Color3.fromHex(hex)
                    end
                end
                Library:UpdateTheme()
            end

            if decoded.Flags then
                for flag, val in pairs(decoded.Flags) do
                    local elem = Library.ConfigElements[flag]
                    if elem and elem.Set then
                        if type(val) == "table" and val.Type == "Color3" then
                            elem.Set(Color3.fromHex(val.Hex))
                        else
                            elem.Set(val)
                        end
                    end
                end
            end
            Library:Notify({Title = "Config Loaded", Text = "Settings & Theme applied!", Duration = 3})
        end

        LeftBox:Button({
            Name = "Save Config",
            Callback = function()
                local encoded = ExportJSON()
                if writefile then
                    writefile(folderName .. "/" .. configName .. ".json", encoded)
                    Library:Notify({Title = "Config Saved", Text = "Saved " .. configName .. ".json", Duration = 3})
                else
                    setclipboard(encoded)
                    Library:Notify({Title = "Copied JSON", Text = "Executor lacks writefile, copied to clipboard!", Duration = 4})
                end
            end
        })

        LeftBox:Button({
            Name = "Load Config",
            Callback = function()
                local path = folderName .. "/" .. configName .. ".json"
                if readfile and isfile and isfile(path) then
                    ImportJSON(readfile(path))
                else
                    Library:Notify({Title = "Error", Text = "Config file not found!", Duration = 3})
                end
            end
        })

        LeftBox:Textbox({
            Name = "Paste JSON Here",
            Placeholder = "Paste JSON config...",
            Callback = function(v) jsonPreview = v end
        })

        LeftBox:Button({
            Name = "Load From JSON Text",
            Callback = function()
                ImportJSON(jsonPreview)
            end
        })

        local themeKeys = {
            {Name = "Accent Color", Key = "Accent"},
            {Name = "Background Color", Key = "Background"},
            {Name = "Groupbox Color", Key = "Groupbox"},
            {Name = "Text Color", Key = "Text"},
            {Name = "Toggle Off Color", Key = "ToggleOff"}
        }

        for _, tInfo in ipairs(themeKeys) do
            local tToggle = RightBox:Toggle({
                Name = tInfo.Name,
                Default = true,
                Flag = "_Theme_" .. tInfo.Key
            })
            tToggle:AddColorpicker({
                Default = Library.Theme[tInfo.Key],
                Flag = "_ThemeColor_" .. tInfo.Key,
                Callback = function(col)
                    Library.Theme[tInfo.Key] = col
                    Library:UpdateTheme()
                end
            })
        end
    end

    return WindowObj
end

return Library, WindowConstructor