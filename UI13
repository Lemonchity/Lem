    local TitleLbl = Create("TextLabel", {
        Parent = NotifFrame,
        Position = UDim2.new(0, 10, 0, 4),
        Size = UDim2.new(1, -20, 0, 16),
        BackgroundTransparency = 1,
        Font = Library.Font,
        Text = title,
        TextColor3 = Library.Theme.Accent,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local TextLbl = Create("TextLabel", {
        Parent = NotifFrame,
        Position = UDim2.new(0, 10, 0, 20),
        Size = UDim2.new(1, -20, 0, 16),
        BackgroundTransparency = 1,
        Font = Library.Font,
        Text = "",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local TimerBar = Create("Frame", {
        Parent = NotifFrame,
        Position = UDim2.new(0, 0, 1, -3),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Library.Theme.Accent,
        BorderSizePixel = 0
    })

    table.insert(ActiveNotifs, 1, NotifFrame)
    UpdateNotifPositions()

    Tween(NotifFrame, {0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out}, {BackgroundTransparency = 0.05})
    Tween(TimerBar, {duration, Enum.EasingStyle.Linear}, {Size = UDim2.new(0, 0, 0, 3)})

    task.spawn(function()
        for i = 1, #text do
            if not TextLbl or not TextLbl.Parent then break end
            TextLbl.Text = string.sub(text, 1, i)
            task.wait(0.025)
        end
    end)

    task.delay(duration, function()
        local idx = table.find(ActiveNotifs, NotifFrame)
        if idx then table.remove(ActiveNotifs, idx) end
        UpdateNotifPositions()

        Tween(NotifFrame, {0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In}, {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 240, 0, 0)
        })
        task.wait(0.32)
        NotifFrame:Destroy()
    end)
end

