                })
                RegisterTheme(Title, "TextColor3", "Text")

                local SwitchBg = Create("TextButton", {
                    Parent = Row,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.new(0, 36, 0, 18),
