-- ==========================================
-- ПОДДЕРЖКА LUCIDE ICONS + RBXASSETID
-- ==========================================
local LucideCache = {}
local LucideMap = nil

local function LoadLucideMap()
    if LucideMap then return LucideMap end
    local ok, res = pcall(function()
        local raw = game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/main/lucide/dist/Icons.lua")
        return loadstring(raw)()
    end)
    if ok and type(res) == "table" then
        LucideMap = res
    else
        LucideMap = {}
    end
    return LucideMap
end

local function ResolveIcon(iconInput)
    if not iconInput or iconInput == "" then
        return ""
    end
    local str = tostring(iconInput)
    -- Если уже передан rbxassetid или http ссылка
    if string.find(str, "rbxassetid://") or string.find(str, "http") then
        return str
    end
    -- Если передано только число
    if tonumber(str) then
        return "rbxassetid://" .. str
    end

    local cleanName = string.lower(str):gsub("^lucide:", "")
    if LucideCache[cleanName] then
        return LucideCache[cleanName]
    end

    -- 1. Попытка взять готовый rbxassetid из базы Lucide для Roblox
    local map = LoadLucideMap()
    if map[cleanName] then
        LucideCache[cleanName] = map[cleanName]
        return map[cleanName]
    end

    -- 2. Фоллбэк: загрузка PNG иконки Lucide через getcustomasset
    if getcustomasset and writefile and isfile and makefolder then
        pcall(function()
            if not isfolder("NeverloseIcons") then
                makefolder("NeverloseIcons")
            end
            local path = "NeverloseIcons/" .. cleanName .. ".png"
            if not isfile(path) then
                local imgData = game:HttpGet("https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/" .. cleanName .. ".png")
                writefile(path, imgData)
            end
            LucideCache[cleanName] = getcustomasset(path)
        end)
        if LucideCache[cleanName] then
            return LucideCache[cleanName]
        end
    end

    return "rbxassetid://7733960981"
end

-- Вспомогательные функции
local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function Tween(inst, info, props)
    local t = TweenService:Create(inst, TweenInfo.new(unpack(info)), props)
    t:Play()
    return t
end

local function RegisterTheme(obj, prop, themeKey)
    table.insert(Library.ThemeObjects, {Obj = obj, Prop = prop, Key = themeKey})
    obj[prop] = Library.Theme[themeKey]
end

function Library:UpdateTheme()
    for _, item in ipairs(Library.ThemeObjects) do
        if item.Obj and item.Obj.Parent then
            item.Obj[item.Prop] = Library.Theme[item.Key]
        end
    end
end

-- Эффект бегущей змейки (Stroke + Gradient)
local function ApplySnakeStroke(parent, thickness)
    local stroke = Create("UIStroke", {
        Parent = parent,
        Thickness = thickness or 1.8,
        Color = Color3.fromRGB(255, 255, 255),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })

    local gradient = Create("UIGradient", {
        Parent = stroke,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Library.Theme.Accent),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 25, 45))
        })
    })

    RunService.RenderStepped:Connect(function(dt)
        if gradient and gradient.Parent then
            gradient.Rotation = (gradient.Rotation + (120 * dt)) % 360
        end
    end)

    return stroke, gradient
end

-- Dragging с поддержкой Anti-Hide
local function MakeDraggable(frame, dragHandle, antiHide)
    local dragging, dragInput, dragStart, startPos
    dragHandle = dragHandle or frame

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y

            if antiHide and frame.Parent then
                local screenSize = frame.Parent.AbsoluteSize
                local absSize = frame.AbsoluteSize
                newX = math.clamp(newX, 0, math.max(0, screenSize.X - absSize.X))
                newY = math.clamp(newY, 0, math.max(0, screenSize.Y - absSize.Y))
            end

            frame.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
        end
    end)
end

