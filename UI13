local spawnTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if not Library.Open then return end

    spawnTimer = spawnTimer + dt
    if spawnTimer < 0.03 then return end
    spawnTimer = 0

    local mousePos = UserInputService:GetMouseLocation()
    local offsetX = math.random(-35, 35)
    local offsetY = math.random(-20, 10)
    local size = math.random(2, 4)

    local Dot = Create("Frame", {
        Parent = ParticleContainer,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, mousePos.X + offsetX, 0, mousePos.Y + offsetY),
        Size = UDim2.new(0, size, 0, size),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ZIndex = 100
    })
    Create("UICorner", {Parent = Dot, CornerRadius = UDim.new(1, 0)})

    local fallDistance = math.random(40, 85)
    local driftX = math.random(-20, 20)
    local lifeTime = math.random(6, 11) / 10

    local tween = Tween(Dot, {lifeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out}, {
        Position = UDim2.new(0, mousePos.X + offsetX + driftX, 0, mousePos.Y + offsetY + fallDistance),
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 0, 0)
    })

    tween.Completed:Connect(function()
        Dot:Destroy()
    end)
end)

