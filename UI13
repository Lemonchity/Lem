                    VerticalAlignment = Enum.VerticalAlignment.Center,
                    Padding = UDim.new(0, 5)
                })

                local function SetState(val)
                    state = val
                    Library.Flags[flag] = state
                    Tween(SwitchBg, {0.2}, {
                        BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.ToggleOff
                    })
                    Tween(Knob, {0.2, Enum.EasingStyle.Back}, {
                        Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                    })
                    if cfg.Callback then cfg.Callback(state) end
                end

                SwitchBg.MouseButton1Click:Connect(function()
                    SetState(not state)
                end)

                Library.Flags[flag] = state
                Library.ConfigElements[flag] = {Type = "Toggle", Set = SetState}

                local ToggleObj = { Set = SetState }

                function ToggleObj:AddColorpicker(cpCfg)
                    local cpFlag = cpCfg.Flag or (flag .. "_Color")
                    local currentColor = cpCfg.Default or Color3.fromRGB(0, 170, 255)
                    local h, s, v = currentColor:ToHSV()

                    local PreviewBtn = Create("TextButton", {
                        Parent = AddonsFrame,
                        Size = UDim2.new(0, 22, 0, 16),
                        BackgroundColor3 = currentColor,
                        Text = "",
                        AutoButtonColor = false
                    })
                    Create("UICorner", {Parent = PreviewBtn, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = PreviewBtn, Color = Library.Theme.Border, Thickness = 1})

                    local PickerWindow = Create("Frame", {
                        Parent = ScreenGui,
                        Size = UDim2.new(0, 210, 0, 225),
                        BackgroundColor3 = Library.Theme.Background,
                        Visible = false,
                        ZIndex = 50
                    })
                    Create("UICorner", {Parent = PickerWindow, CornerRadius = UDim.new(0, 6)})
                    ApplySnakeStroke(PickerWindow, 1.5)

                    local SatValBox = Create("ImageButton", {
                        Parent = PickerWindow,
                        Position = UDim2.new(0, 10, 0, 10),
                        Size = UDim2.new(0, 165, 0, 165),
                        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
                        Image = "rbxassetid://4155801252",
                        AutoButtonColor = false,
                        ZIndex = 51
                    })
                    Create("UICorner", {Parent = SatValBox, CornerRadius = UDim.new(0, 4)})

                    local Cursor = Create("Frame", {
                        Parent = SatValBox,
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(s, 0, 1 - v, 0),
                        Size = UDim2.new(0, 8, 0, 8),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        ZIndex = 52
                    })
                    Create("UICorner", {Parent = Cursor, CornerRadius = UDim.new(1, 0)})
                    Create("UIStroke", {Parent = Cursor, Color = Color3.new(0, 0, 0), Thickness = 1.5})

                    local HueBar = Create("TextButton", {
                        Parent = PickerWindow,
                        Position = UDim2.new(0, 183, 0, 10),
                        Size = UDim2.new(0, 17, 0, 165),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 51
                    })
                    Create("UICorner", {Parent = HueBar, CornerRadius = UDim.new(0, 4)})
                    Create("UIGradient", {
                        Parent = HueBar,
                        Rotation = 90,
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
                        })
                    })

                    local HexBox = Create("TextBox", {
                        Parent = PickerWindow,
                        Position = UDim2.new(0, 10, 0, 185),
                        Size = UDim2.new(1, -20, 0, 28),
                        BackgroundColor3 = Library.Theme.ToggleOff,
                        Font = Library.Font,
                        Text = "#" .. currentColor:ToHex():upper(),
                        TextColor3 = Library.Theme.Text,
                        TextSize = 14,
                        ZIndex = 51
                    })
                    Create("UICorner", {Parent = HexBox, CornerRadius = UDim.new(0, 4)})

                    local function UpdateColor(newColor, skipHex)
                        currentColor = newColor
                        h, s, v = currentColor:ToHSV()
                        PreviewBtn.BackgroundColor3 = currentColor
                        SatValBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                        Cursor.Position = UDim2.new(s, 0, 1 - v, 0)
                        if not skipHex then
                            HexBox.Text = "#" .. currentColor:ToHex():upper()
                        end
                        Library.Flags[cpFlag] = currentColor
                        if cpCfg.Callback then cpCfg.Callback(currentColor) end
                    end

                    local draggingSV, draggingHue = false, false
                    SatValBox.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = true
                        end
                    end)
                    HueBar.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = true
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = false
                            draggingHue = false
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(inp)
                        if draggingSV and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            local relX = math.clamp((inp.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
                            local relY = math.clamp((inp.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
                            UpdateColor(Color3.fromHSV(h, relX, 1 - relY))
                        elseif draggingHue and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            local relY = math.clamp((inp.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                            UpdateColor(Color3.fromHSV(relY, s, v))
                        end
                    end)

                    HexBox.FocusLost:Connect(function()
                        local clean = HexBox.Text:gsub("#", "")
                        if #clean == 6 then
                            local ok, col = pcall(Color3.fromHex, clean)
                            if ok then UpdateColor(col) end
                        end
                    end)

                    PreviewBtn.MouseButton1Click:Connect(function()
                        PickerWindow.Visible = not PickerWindow.Visible
                        if PickerWindow.Visible then
                            local pos = PreviewBtn.AbsolutePosition
                            PickerWindow.Position = UDim2.new(0, pos.X + 28, 0, pos.Y)
                        end
                    end)

                    Library.Flags[cpFlag] = currentColor
                    Library.ConfigElements[cpFlag] = {Type = "Colorpicker", Set = UpdateColor}
                    return ToggleObj
                end

                function ToggleObj:AddKeybind(kbCfg)
                    local kbFlag = kbCfg.Flag or (flag .. "_Keybind")
                    local currentKey = kbCfg.Default or Enum.KeyCode.None
                    local mode = kbCfg.Mode or "Toggle"
                    local binding = false

                    local KeyBtn = Create("TextButton", {
                        Parent = AddonsFrame,
                        Size = UDim2.new(0, 42, 0, 18),
                        BackgroundColor3 = Library.Theme.ToggleOff,
                        Font = Library.Font,
                        Text = currentKey == Enum.KeyCode.None and "NONE" or currentKey.Name,
                        TextColor3 = Library.Theme.Text,
                        TextSize = 11,
                        AutoButtonColor = false
                    })
                    Create("UICorner", {Parent = KeyBtn, CornerRadius = UDim.new(0, 4)})

                    local GearBtn = Create("TextButton", {
                        Parent = AddonsFrame,
                        Size = UDim2.new(0, 18, 0, 18),
                        BackgroundTransparency = 1,
                        Font = Library.Font,
                        Text = "⚙",
                        TextColor3 = Library.Theme.SubText,
                        TextSize = 14
                    })

                    local ModeMenu = Create("Frame", {
                        Parent = ScreenGui,
                        Size = UDim2.new(0, 110, 0, 0),
                        BackgroundColor3 = Library.Theme.Background,
                        ClipsDescendants = true,
                        Visible = false,
                        ZIndex = 60
                    })
                    Create("UICorner", {Parent = ModeMenu, CornerRadius = UDim.new(0, 5)})
                    ApplySnakeStroke(ModeMenu, 1.2)
                    Create("UIListLayout", {Parent = ModeMenu, Padding = UDim.new(0, 2)})

                    local modes = {"Toggle", "Hold", "Always On"}
                    local modeBtns = {}

                    local function SetMode(m)
                        mode = m
                        for name, b in pairs(modeBtns) do
                            b.TextColor3 = (name == mode) and Library.Theme.Accent or Library.Theme.Text
                        end
                        if mode == "Always On" then
                            SetState(true)
                        end
                        Library.Flags[kbFlag .. "_Mode"] = mode
                    end

                    for _, mName in ipairs(modes) do
                        local mBtn = Create("TextButton", {
                            Parent = ModeMenu,
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundTransparency = 1,
                            Font = Library.Font,
                            Text = mName,
                            TextColor3 = (mName == mode) and Library.Theme.Accent or Library.Theme.Text,
                            TextSize = 13,
                            ZIndex = 61
                        })
                        modeBtns[mName] = mBtn
                        mBtn.MouseButton1Click:Connect(function()
                            SetMode(mName)
                            Tween(ModeMenu, {0.2}, {Size = UDim2.new(0, 110, 0, 0)})
                            task.wait(0.2)
                            ModeMenu.Visible = false
                        end)
                    end

                    GearBtn.MouseButton1Click:Connect(function()
                        if ModeMenu.Visible then
                            Tween(ModeMenu, {0.2}, {Size = UDim2.new(0, 110, 0, 0)})
                            task.wait(0.2)
                            ModeMenu.Visible = false
                        else
                            local pos = GearBtn.AbsolutePosition
                            ModeMenu.Position = UDim2.new(0, pos.X + 22, 0, pos.Y)
                            ModeMenu.Visible = true
                            Tween(ModeMenu, {0.25, Enum.EasingStyle.Back}, {Size = UDim2.new(0, 110, 0, 78)})
                        end
                    end)

                    KeyBtn.MouseButton1Click:Connect(function()
                        binding = true
                        KeyBtn.Text = "..."
                    end)

                    UserInputService.InputBegan:Connect(function(input, gpe)
                        if binding then
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                currentKey = input.KeyCode
                                KeyBtn.Text = currentKey.Name
                                binding = false
                                Library.Flags[kbFlag] = currentKey.Name
                            end
                            return
                        end

                        if not gpe and input.KeyCode == currentKey and currentKey ~= Enum.KeyCode.None then
                            if mode == "Toggle" then
                                SetState(not state)
                            elseif mode == "Hold" then
                                SetState(true)
                            end
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.KeyCode == currentKey and mode == "Hold" then
                            SetState(false)
                        end
                    end)

                    Library.Flags[kbFlag] = currentKey.Name
                    Library.Flags[kbFlag .. "_Mode"] = mode
                    Library.ConfigElements[kbFlag] = {
                        Type = "Keybind",
                        Set = function(kName)
                            local ok, kc = pcall(function() return Enum.KeyCode[kName] end)
                            if ok and kc then
                                currentKey = kc
                                KeyBtn.Text = kc.Name
                                Library.Flags[kbFlag] = kc.Name
                            end
                        end
                    }
                    return ToggleObj
                end

                return ToggleObj
            end

            function Elements:Slider(cfg)
                local flag = cfg.Flag or cfg.Name
                local min = cfg.Min or 0
                local max = cfg.Max or 100
                local val = math.clamp(cfg.Default or min, min, max)

                local Frame = Create("Frame", {
                    Parent = Content,
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1
                })

                local Title = Create("TextLabel", {
                    Parent = Frame,
                    Size = UDim2.new(0.7, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Library.Font,
                    Text = cfg.Name or "Slider",
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                RegisterTheme(Title, "TextColor3", "Text")

                local ValLbl = Create("TextLabel", {
                    Parent = Frame,
                    Position = UDim2.new(0.7, 0, 0, 0),
                    Size = UDim2.new(0.3, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Library.Font,
                    Text = tostring(val),
                    TextColor3 = Library.Theme.Accent,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Right
                })
                RegisterTheme(ValLbl, "TextColor3", "Accent")

                local BarBg = Create("TextButton", {
                    Parent = Frame,
                    Position = UDim2.new(0, 0, 0, 22),
                    Size = UDim2.new(1, 0, 0, 8),
                    BackgroundColor3 = Library.Theme.ToggleOff,
                    Text = "",
                    AutoButtonColor = false
                })
                RegisterTheme(BarBg, "BackgroundColor3", "ToggleOff")
                Create("UICorner", {Parent = BarBg, CornerRadius = UDim.new(1, 0)})

                local Fill = Create("Frame", {
                    Parent = BarBg,
                    Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Library.Theme.Accent
                })
                RegisterTheme(Fill, "BackgroundColor3", "Accent")
                Create("UICorner", {Parent = Fill, CornerRadius = UDim.new(1, 0)})

                local function SetSlider(newVal)
                    val = math.clamp(math.floor(newVal + 0.5), min, max)
                    ValLbl.Text = tostring(val)
                    Library.Flags[flag] = val
                    Tween(Fill, {0.1}, {Size = UDim2.new((val - min) / (max - min), 0, 1, 0)})
                    if cfg.Callback then cfg.Callback(val) end
                end

                local sliding = false
                BarBg.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        local pct = math.clamp((inp.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                        SetSlider(min + (max - min) * pct)
                    end
                end)
                UserInputService.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(inp)
                    if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        local pct = math.clamp((inp.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                        SetSlider(min + (max - min) * pct)
                    end
                end)

                Library.Flags[flag] = val
                Library.ConfigElements[flag] = {Type = "Slider", Set = SetSlider}
            end

            function Elements:Dropdown(cfg)
                local flag = cfg.Flag or cfg.Name
                local options = cfg.Options or {}
                local selected = cfg.Default or options[1] or "None"
                local opened = false

                local Frame = Create("Frame", {
                    Parent = Content,
                    Size = UDim2.new(1, 0, 0, 44),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1
                })

                local Title = Create("TextLabel", {
                    Parent = Frame,
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Library.Font,
                    Text = cfg.Name or "Dropdown",
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                RegisterTheme(Title, "TextColor3", "Text")

                local DropBtn = Create("TextButton", {
                    Parent = Frame,
                    Position = UDim2.new(0, 0, 0, 18),
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = Library.Theme.ToggleOff,
                    Font = Library.Font,
                    Text = "  " .. tostring(selected),
                    TextColor3 = Library.Theme.Accent,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false
                })
                RegisterTheme(DropBtn, "BackgroundColor3", "ToggleOff")
                RegisterTheme(DropBtn, "TextColor3", "Accent")
                Create("UICorner", {Parent = DropBtn, CornerRadius = UDim.new(0, 5)})

                local ListFrame = Create("Frame", {
                    Parent = Frame,
                    Position = UDim2.new(0, 0, 0, 46),
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = Library.Theme.Background,
                    ClipsDescendants = true,
                    Visible = false
                })
                Create("UICorner", {Parent = ListFrame, CornerRadius = UDim.new(0, 5)})
                Create("UIListLayout", {Parent = ListFrame})

                local function SetOption(opt)
                    selected = opt
                    DropBtn.Text = "  " .. tostring(selected)
                    Library.Flags[flag] = selected
                    if cfg.Callback then cfg.Callback(selected) end
                end

                for _, opt in ipairs(options) do
                    local OptBtn = Create("TextButton", {
                        Parent = ListFrame,
                        Size = UDim2.new(1, 0, 0, 24),
                        BackgroundTransparency = 1,
                        Font = Library.Font,
                        Text = "  " .. tostring(opt),
                        TextColor3 = Library.Theme.Text,
                        TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Left
                    })
                    OptBtn.MouseButton1Click:Connect(function()
                        SetOption(opt)
                        opened = false
                        ListFrame.Visible = false
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    ListFrame.Visible = opened
                    ListFrame.Size = opened and UDim2.new(1, 0, 0, #options * 24) or UDim2.new(1, 0, 0, 0)
                end)

                Library.Flags[flag] = selected
                Library.ConfigElements[flag] = {Type = "Dropdown", Set = SetOption}
            end

            local Proxy = setmetatable({
                Slider = function(_, c) return Elements:Slider(c) end,
                Toggle = function(_, c) return Elements:Toggle(c) end,
                Dropdown = function(_, c) return Elements:Dropdown(c) end,
                Textbox = function(_, c) return Elements:Textbox(c) end,
                Button = function(_, c) return Elements:Button(c) end,
                Label = function(_, t) return Elements:Label(t) end
            }, {__index = Elements})

            return Proxy
        end

        return TabObj
    end

