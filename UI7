            valOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            valOverlay.BackgroundTransparency = 0
            valOverlay.BorderSizePixel = 0
            valOverlay.ZIndex = 42
            valOverlay.Parent = svCanvas

            local valCorner = Instance.new("UICorner")
