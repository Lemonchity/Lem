local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Library = {}
Library.__index = Library

local ARCADE_FONT = Enum.Font.Arcade
local activeNotifications = {}

function Library:Notify(titleText, messageText, duration)
    duration = duration or 4

    local notifGui = PlayerGui:FindFirstChild("NeonNotifGui")
    if not notifGui then
        notifGui = Instance.new("ScreenGui")
        notifGui.Name = "NeonNotifGui"
        notifGui.ResetOnSpawn = false
        notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        notifGui.DisplayOrder = 100
        notifGui.Parent = PlayerGui
    end

    for i, item in ipairs(activeNotifications) do
        local targetYOffset = i * 68
        TweenService:Create(item.Frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -135, 0.65, targetYOffset)
        }):Play()
    end

    local notifFrame = Instance.new("Frame")
    notifFrame.Name = "Notification"
    notifFrame.Size = UDim2.new(0, 270, 0, 60)
    notifFrame.Position = UDim2.new(0.5, -135, 0.65, -15)
    notifFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    notifFrame.BackgroundTransparency = 1
    notifFrame.BorderSizePixel = 0
    notifFrame.Parent = notifGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notifFrame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Transparency = 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = notifFrame

    local strokeGradient = Instance.new("UIGradient")
    strokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 170, 255)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(170, 0, 255)),
        ColorSequenceKeypoint.new(0.66, Color3.fromRGB(255, 0, 128)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 170, 255))
    })
    strokeGradient.Parent = stroke

    local rotConnection
    rotConnection = RunService.RenderStepped:Connect(function(dt)
        if not notifFrame or not notifFrame.Parent then
            rotConnection:Disconnect()
            return
        end
        strokeGradient.Rotation = (strokeGradient.Rotation + dt * 140) % 360
    end)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 18)
    title.Position = UDim2.new(0, 10, 0, 8)
    title.BackgroundTransparency = 1
    title.Text = string.upper(titleText or "NOTIFICATION")
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextTransparency = 1
    title.Font = ARCADE_FONT
    title.TextSize = 16
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notifFrame

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -20, 0, 22)
    desc.Position = UDim2.new(0, 10, 0, 26)
    desc.BackgroundTransparency = 1
    desc.Text = messageText or ""
    desc.TextColor3 = Color3.fromRGB(180, 180, 200)
    desc.TextTransparency = 1
    desc.Font = ARCADE_FONT
    desc.TextSize = 14
    desc.TextWrapped = true
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = notifFrame

    local barTrack = Instance.new("Frame")
    barTrack.Size = UDim2.new(1, -16, 0, 3)
    barTrack.Position = UDim2.new(0, 8, 1, -7)
    barTrack.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    barTrack.BackgroundTransparency = 1
    barTrack.BorderSizePixel = 0
    barTrack.Parent = notifFrame

    local barTrackCorner = Instance.new("UICorner")
    barTrackCorner.CornerRadius = UDim.new(1, 0)
    barTrackCorner.Parent = barTrack

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    barFill.BackgroundTransparency = 1
    barFill.BorderSizePixel = 0
    barFill.Parent = barTrack

    local barFillCorner = Instance.new("UICorner")
    barFillCorner.CornerRadius = UDim.new(1, 0)
    barFillCorner.Parent = barFill

    local notifData = { Frame = notifFrame }
    table.insert(activeNotifications, 1, notifData)

    local spawnTween = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(notifFrame, spawnTween, { Position = UDim2.new(0.5, -135, 0.65, 0), BackgroundTransparency = 0 }):Play()
    TweenService:Create(stroke, spawnTween, { Transparency = 0 }):Play()
    TweenService:Create(title, spawnTween, { TextTransparency = 0 }):Play()
    TweenService:Create(desc, spawnTween, { TextTransparency = 0 }):Play()
    TweenService:Create(barTrack, spawnTween, { BackgroundTransparency = 0 }):Play()
    TweenService:Create(barFill, spawnTween, { BackgroundTransparency = 0 }):Play()

    TweenService:Create(barFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 1, 0)
    }):Play()

    task.delay(duration, function()
        local index = table.find(activeNotifications, notifData)
        if index then
            table.remove(activeNotifications, index)
        end

        for idx, item in ipairs(activeNotifications) do
            local targetY = (idx - 1) * 68
            TweenService:Create(item.Frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -135, 0.65, targetY)
            }):Play()
        end

        local fadeOut = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        local curPos = notifFrame.Position
        TweenService:Create(notifFrame, fadeOut, {
            Position = UDim2.new(curPos.X.Scale, curPos.X.Offset, curPos.Y.Scale, curPos.Y.Offset + 25),
            BackgroundTransparency = 1
        }):Play()
        TweenService:Create(stroke, fadeOut, { Transparency = 1 }):Play()
        TweenService:Create(title, fadeOut, { TextTransparency = 1 }):Play()
        TweenService:Create(desc, fadeOut, { TextTransparency = 1 }):Play()
        TweenService:Create(barTrack, fadeOut, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(barFill, fadeOut, { BackgroundTransparency = 1 }):Play()

        task.wait(0.3)
        notifFrame:Destroy()
    end)
end

function Library.CreateWindow(config)
    local titleText = "ARCADE HUB"
    local toggleKey = Enum.KeyCode.RightControl

    if type(config) == "table" then
        titleText = config.Title or config.Name or titleText
        if config.Keybind then
            if typeof(config.Keybind) == "EnumItem" then
                toggleKey = config.Keybind
            elseif type(config.Keybind) == "string" then
                toggleKey = Enum.KeyCode[config.Keybind] or Enum.KeyCode.RightControl
            end
        end
    elseif type(config) == "string" then
        titleText = config
    end

    local self = setmetatable({}, Library)
    self.Tabs = {}
    self.ActiveTab = nil
    self.IsOpen = true

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "NeonCustomUI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = PlayerGui

    local main = Instance.new("Frame")
    main.Name = "MainFrame"
    main.Size = UDim2.new(0, 580, 0, 440)
    main.Position = UDim2.new(0.5, -290, 0.5, -220)
    main.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    main.BorderSizePixel = 0
    main.ClipsDescendants = false
    main.Parent = screenGui
    self.Main = main

    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 10)
    mainCorner.Parent = main

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = main

    local strokeGradient = Instance.new("UIGradient")
    strokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 170, 255)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(170, 0, 255)),
        ColorSequenceKeypoint.new(0.66, Color3.fromRGB(255, 0, 128)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 170, 255))
    })
    strokeGradient.Parent = stroke

    local rot = 0
    RunService.RenderStepped:Connect(function(dt)
        rot = (rot + dt * 120) % 360
        strokeGradient.Rotation = rot
    end)

    local topbar = Instance.new("Frame")
    topbar.Size = UDim2.new(1, 0, 0, 36)
    topbar.BackgroundTransparency = 1
    topbar.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 1, 0)
    title.Position = UDim2.new(0, 15, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = string.upper(titleText)
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Font = ARCADE_FONT
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = topbar

    local tabContainer = Instance.new("ScrollingFrame")
    tabContainer.Size = UDim2.new(1, -20, 0, 34)
    tabContainer.Position = UDim2.new(0, 10, 0, 38)
    tabContainer.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    tabContainer.BorderSizePixel = 0
    tabContainer.ScrollBarThickness = 0
    tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabContainer.AutomaticCanvasSize = Enum.AutomaticSize.X
    tabContainer.Parent = main
    self.TabContainer = tabContainer

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 6)
    tabCorner.Parent = tabContainer

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0, 6)
    tabLayout.Parent = tabContainer

    local tabPadding = Instance.new("UIPadding")
    tabPadding.PaddingLeft = UDim.new(0, 4)
    tabPadding.PaddingRight = UDim.new(0, 4)
    tabPadding.PaddingTop = UDim.new(0, 3)
    tabPadding.PaddingBottom = UDim.new(0, 3)
    tabPadding.Parent = tabContainer

    local pagesHolder = Instance.new("Frame")
    pagesHolder.Size = UDim2.new(1, -20, 1, -84)
    pagesHolder.Position = UDim2.new(0, 10, 0, 78)
    pagesHolder.BackgroundTransparency = 1
    pagesHolder.Parent = main
    self.PagesHolder = pagesHolder

    local dragging, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local mainScale = Instance.new("UIScale")
    mainScale.Scale = 1
    mainScale.Parent = main

    local isToggling = false
    local function toggleMenu()
        if isToggling then return end
        isToggling = true
        self.IsOpen = not self.IsOpen

        if self.IsOpen then
            main.Visible = true
            local twIn = TweenService:Create(mainScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
            twIn:Play()
            twIn.Completed:Connect(function()
                isToggling = false
            end)
        else
            local twOut = TweenService:Create(mainScale, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.85})
            twOut:Play()
            twOut.Completed:Connect(function()
                if not self.IsOpen then
                    main.Visible = false
                end
                isToggling = false
            end)
        end
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == toggleKey then
            toggleMenu()
        end
    end)

    return self
end

function Library:AddTab(tabName)
    local tab = {}
    local window = self

    local page = Instance.new("Frame")
    page.Name = "Page_" .. tabName
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = window.PagesHolder
    tab.Page = page

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 100, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    tabBtn.BackgroundTransparency = 0.5
    tabBtn.Text = ""
    tabBtn.AutoButtonColor = false
    tabBtn.Parent = window.TabContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = tabBtn

    local tabLabel = Instance.new("TextLabel")
    tabLabel.Size = UDim2.new(1, 0, 1, 0)
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text = string.upper(tabName)
    tabLabel.Font = ARCADE_FONT
    tabLabel.TextSize = 14
    tabLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
    tabLabel.Parent = tabBtn

    tab.Button = tabBtn
    tab.Label = tabLabel

    function tab:Activate()
        for _, otherTab in ipairs(window.Tabs) do
            if otherTab ~= tab then
                otherTab.Page.Visible = false
                TweenService:Create(otherTab.Label, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    TextSize = 14,
                    TextColor3 = Color3.fromRGB(150, 150, 170)
                }):Play()
                TweenService:Create(otherTab.Button, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(24, 24, 30),
                    BackgroundTransparency = 0.5
                }):Play()
            end
        end

        tab.Page.Visible = true
        window.ActiveTab = tab

        local animInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(tab.Label, animInfo, {
            TextSize = 18,
            TextColor3 = Color3.fromRGB(0, 255, 255)
        }):Play()

        TweenService:Create(tab.Button, animInfo, {
            BackgroundColor3 = Color3.fromRGB(35, 45, 65),
            BackgroundTransparency = 0
        }):Play()
    end

    tabBtn.MouseButton1Click:Connect(function()
        if window.ActiveTab ~= tab then
            tab:Activate()
        end
    end)

    table.insert(window.Tabs, tab)

    if #window.Tabs == 1 then
        tab:Activate()
    end

    function tab:AddColumn(side)
        local col = {}
        local isLeft = (side == "Left")

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(0.49, 0, 1, 0)
        scroll.Position = isLeft and UDim2.new(0, 0, 0, 0) or UDim2.new(0.51, 0, 0, 0)
        scroll.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.ScrollBarImageColor3 = Color3.fromRGB(90, 90, 120)
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.Parent = self.Page

        local colCorner = Instance.new("UICorner")
        colCorner.CornerRadius = UDim.new(0, 8)
        colCorner.Parent = scroll

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = scroll

        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, 8)
        padding.PaddingBottom = UDim.new(0, 8)
        padding.PaddingLeft = UDim.new(0, 8)
        padding.PaddingRight = UDim.new(0, 8)
        padding.Parent = scroll

        col.Holder = scroll

        function col:AddButton(text, callback)
            callback = callback or function() end
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 34)
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            btn.TextColor3 = Color3.fromRGB(230, 230, 230)
            btn.Text = text
            btn.Font = ARCADE_FONT
            btn.TextSize = 16
            btn.AutoButtonColor = false
            btn.Parent = self.Holder

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(60, 60, 85)}):Play()
                task.wait(0.08)
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play()
                callback()
            end)
        end

        function col:AddToggle(text, default, callback)
            callback = callback or function() end
            local state = default or false

            local toggleFrame = Instance.new("TextButton")
            toggleFrame.Size = UDim2.new(1, 0, 0, 34)
            toggleFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            toggleFrame.Text = ""
            toggleFrame.AutoButtonColor = false
            toggleFrame.Parent = self.Holder

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = toggleFrame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -50, 1, 0)
            label.Position = UDim2.new(0, 10, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(230, 230, 230)
            label.Font = ARCADE_FONT
            label.TextSize = 15
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = toggleFrame

            local box = Instance.new("Frame")
            box.Size = UDim2.new(0, 20, 0, 20)
            box.Position = UDim2.new(1, -28, 0.5, -10)
            box.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 65)
            box.Parent = toggleFrame

            local boxCorner = Instance.new("UICorner")
            boxCorner.CornerRadius = UDim.new(0, 4)
            boxCorner.Parent = box

            toggleFrame.MouseButton1Click:Connect(function()
                state = not state
                local targetColor = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 65)
                TweenService:Create(box, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
                callback(state)
            end)
        end

        -- ====================================================
        -- 1. КОМПОНЕНТ: TEXT LABEL
        -- ====================================================
        function col:AddLabel(text)
            local labelFrame = Instance.new("Frame")
            labelFrame.Name = "Label_" .. tostring(text)
            labelFrame.Size = UDim2.new(1, 0, 0, 24)
            labelFrame.BackgroundTransparency = 1
            labelFrame.Parent = self.Holder

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -6, 1, 0)
            label.Position = UDim2.new(0, 3, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = tostring(text)
            label.TextColor3 = Color3.fromRGB(180, 180, 210)
            label.Font = ARCADE_FONT
            label.TextSize = 13
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = labelFrame

            return {
                SetText = function(_, newText)
                    label.Text = tostring(newText)
                end,
                Instance = labelFrame
            }
        end

        -- Вспомогательная функция сборки всплывающего HSV-пикера
        local function createColorPopup(parentRow, initialColor, onColorChanged)
            local h, s, v = initialColor:ToHSV()

            local popup = Instance.new("Frame")
            popup.Name = "ColorPickerPopup"
            popup.Size = UDim2.new(0, 180, 0, 140)
            popup.Position = UDim2.new(1, -185, 1, 6)
