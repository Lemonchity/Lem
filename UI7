            box.Size = UDim2.new(0, 20, 0, 20)
            box.Position = UDim2.new(1, -28, 0.5, -10)
            box.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 65)
            box.BorderSizePixel = 0
            box.Parent = toggleFrame

            local boxCorner = Instance.new("UICorner")
            boxCorner.CornerRadius = UDim.new(0, 4)
            boxCorner.Parent = box

            local function updateToggle(val)
                state = val
                local targetColor = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 65)
                local targetTextColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 200)
                TweenService:Create(box, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = targetTextColor}):Play()
                callback(state)
            end

            toggleFrame.MouseButton1Click:Connect(function()
                updateToggle(not state)
            end)

            local toggleObj = {
                Frame = toggleFrame,
                SetState = function(_, val)
                    updateToggle(val)
                end
            }

            -- Привязка колорпикера: LinkColorpicker:Имятоггла
            function toggleObj:LinkColorpicker(pickerName, defaultColor, colorCallback)
                colorCallback = colorCallback or function() end
                pickerName = pickerName or text
                local curColor = defaultColor or Color3.fromRGB(0, 170, 255)

                -- Сдвигаем чекбокс левее, чтобы освободить место квадратику цвета
                box.Position = UDim2.new(1, -56, 0.5, -10)
                label.Size = UDim2.new(1, -85, 1, 0)

