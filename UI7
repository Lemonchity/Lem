            hueBar.Size = UDim2.new(0, 16, 0, 120)
            hueBar.Position = UDim2.new(1, -24, 0, 10)
            hueBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueBar.AutoButtonColor = false
            hueBar.Text = ""
            hueBar.ZIndex = 41
            hueBar.Parent = popup

            local hueCorner = Instance.new("UICorner")
            hueCorner.CornerRadius = UDim.new(0, 4)
            hueCorner.Parent = hueBar

            local hueGrad = Instance.new("UIGradient")
            hueGrad.Rotation = 90
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
            })
            hueGrad.Parent = hueBar

            local hueCursor = Instance.new("Frame")
            hueCursor.Size = UDim2.new(1, 2, 0, 3)
            hueCursor.AnchorPoint = Vector2.new(0, 0.5)
            hueCursor.Position = UDim2.new(0, -1, h, 0)
            hueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueCursor.BorderSizePixel = 0
            hueCursor.ZIndex = 43
            hueCursor.Parent = hueBar

            local isDraggingSV = false
            local isDraggingHue = false

            local function pushUpdate()
                local finalColor = Color3.fromHSV(h, s, v)
                svCanvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                onColorChanged(finalColor)
            end

            -- Dragging SV
            svCanvas.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDraggingSV = true
                    local relX = math.clamp((input.Position.X - svCanvas.AbsolutePosition.X) / svCanvas.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((input.Position.Y - svCanvas.AbsolutePosition.Y) / svCanvas.AbsoluteSize.Y, 0, 1)
                    s = relX
                    v = 1 - relY
                    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    pushUpdate()
                end
            end)

            -- Dragging Hue
            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDraggingHue = true
                    local relY = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                    h = relY
                    hueCursor.Position = UDim2.new(0, -1, h, 0)
                    pushUpdate()
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDraggingSV = false
                    isDraggingHue = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if isDraggingSV then
                        local relX = math.clamp((input.Position.X - svCanvas.AbsolutePosition.X) / svCanvas.AbsoluteSize.X, 0, 1)
                        local relY = math.clamp((input.Position.Y - svCanvas.AbsolutePosition.Y) / svCanvas.AbsoluteSize.Y, 0, 1)
                        s = relX
                        v = 1 - relY
                        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                        pushUpdate()
                    elseif isDraggingHue then
                        local relY = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                        h = relY
                        hueCursor.Position = UDim2.new(0, -1, h, 0)
                        pushUpdate()
                    end
                end
            end)

            return popup, function(newCol)
                h, s, v = newCol:ToHSV()
                svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                hueCursor.Position = UDim2.new(0, -1, h, 0)
                svCanvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            end
        end

