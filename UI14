    title.Font = Enum.Font.Arcade
    title.TextSize = 15
    title.TextColor3 = Library.Theme.Text
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Text = name
    title.ZIndex = 8
    title.Parent = holder

    local valLbl = Instance.new("TextLabel")
    valLbl.BackgroundTransparency = 1
    valLbl.Position = UDim2.new(0.7, 0, 0, 0)
    valLbl.Size = UDim2.new(0.3, 0, 0, 16)
    valLbl.Font = Enum.Font.Arcade
    valLbl.TextSize = 15
    valLbl.TextColor3 = Library.Theme.Text
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Text = tostring(default)
    valLbl.ZIndex = 8
    valLbl.Parent = holder

    local barBg = Instance.new("TextButton")
    barBg.Position = UDim2.fromOffset(0, 20)
    barBg.Size = UDim2.new(1, 0, 0, 8)
    barBg.BackgroundColor3 = Library.Theme.ElementBg
    barBg.BorderSizePixel = 0
    barBg.Text = ""
    barBg.AutoButtonColor = false
    barBg.ZIndex = 8
    barBg.Parent = holder
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 3)

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.fromScale((default - min) / math.max(max - min, 1), 1)
    barFill.BackgroundColor3 = Library.Theme.Accent
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 9
    barFill.Parent = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 3)

    local SliderObj = {}
    function SliderObj:Set(val)
        val = math.clamp(math.floor(val * 100 + 0.5) / 100, min, max)
        Library.Flags[flag] = val
        valLbl.Text = tostring(val)
        local ratio = (val - min) / math.max(max - min, 0.001)
        Tween(barFill, 0.08, { Size = UDim2.fromScale(ratio, 1) })
        callback(val)
    end

    local sliding = false
    local function UpdateFromInput(input)
        local ratio = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
        local raw = min + (max - min) * ratio
        SliderObj:Set(math.floor(raw + 0.5))
    end

    barBg.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            UpdateFromInput(inp)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromInput(inp)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    Library.FlagObjects[flag] = SliderObj
    return SliderObj
end

