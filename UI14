    local MenuSec = MainPage:Section({ Name = "Menu & Theme", Side = "Left" })

    local MenuBindToggle = Create:Toggle(MenuSec, {
        Name = "Menu Keybind",
        Default = true,
        Flag = "menu_ui_active"
    })
    MenuBindToggle:AddKeybind({
        Default = Library.MenuKeybind,
        Mode = "Toggle",
        Flag = "menu_toggle_bind",
        Callback = function(newKey)
            Library.MenuKeybind = newKey
        end
    })

    local AccentToggle = Create:Toggle(MenuSec, {
        Name = "Accent Color",
        Default = true,
        Flag = "theme_accent_enabled"
    })
    AccentToggle:AddColorpicker({
        Default = Library.Theme.Accent,
        Flag = "theme_accent_color",
        Callback = function(col)
            Library.Theme.Accent = col
            for _, item in ipairs(SnakeGradients) do
                if item.Gradient then
                    item.Gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(12, 22, 20)),
                        ColorSequenceKeypoint.new(0.50, col),
                        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(12, 22, 20))
                    })
                end
            end
        end
    })

    local BgToggle = Create:Toggle(MenuSec, {
        Name = "Background Color",
        Default = true,
        Flag = "theme_bg_enabled"
    })
    BgToggle:AddColorpicker({
        Default = Library.Theme.Background,
        Flag = "theme_bg_color",
        Callback = function(col)
            Library.Theme.Background = col
            for _, obj in ipairs(Library.ThemeObjects.Background) do
                if obj then obj.BackgroundColor3 = col end
            end
        end
    })

    local CfgSec = MainPage:Section({ Name = "JSON Configs", Side = "Right" })

    local cfgNameBox = Add:Textbox(CfgSec, {
        Name = "Config Name",
        Placeholder = "default",
        Default = "default",
        Flag = "cfg_input_name"
    })

    local cfgDropdown = Add:Dropdown(CfgSec, {
        Name = "Saved Configs",
        Options = Library:GetConfigList(),
        Default = "default",
        Flag = "cfg_selected_list",
        Callback = function(selected)
            cfgNameBox:Set(selected)
        end
    })

    Add:Button(CfgSec, {
        Name = "Save Config (JSON)",
        Callback = function()
            local name = Library.Flags["cfg_input_name"]
            Library:SaveConfig(name)
            cfgDropdown:Refresh(Library:GetConfigList())
        end
    })

    Add:Button(CfgSec, {
        Name = "Load Config (JSON)",
        Callback = function()
            local name = Library.Flags["cfg_input_name"]
            Library:LoadConfig(name)
        end
    })

    return SettingsTab
end

