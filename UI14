local function GetHealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        return Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(0, 255, 100), (ratio - 0.5) * 2)
    else
        return Color3.fromRGB(255, 45, 45):Lerp(Color3.fromRGB(255, 255, 0), ratio * 2)
    end
end

