local function EnsureConfigFolder()
    if isfolder and makefolder and not isfolder(Library.ConfigFolder) then
        makefolder(Library.ConfigFolder)
    end
end

local function SerializeValue(val)
    if typeof(val) == "Color3" then
        return { __type = "Color3", R = val.R, G = val.G, B = val.B }
    elseif typeof(val) == "EnumItem" then
        return { __type = "EnumItem", EnumType = tostring(val.EnumType), Name = val.Name }
    end
    return val
end

local function DeserializeValue(val)
    if type(val) == "table" then
        if val.__type == "Color3" then
            return Color3.new(val.R, val.G, val.B)
        elseif val.__type == "EnumItem" then
            local ok, enumObj = pcall(function()
                return Enum[val.EnumType][val.Name]
            end)
            if ok then return enumObj end
        end
    end
    return val
end

function Library:SaveConfig(configName)
    if not configName or configName == "" then
        Library:Notify({ Title = "Config Error", Text = "Enter config name first!", Duration = 3 })
        return
    end
    EnsureConfigFolder()

    local data = {}
    for flag, value in pairs(Library.Flags) do
        data[flag] = SerializeValue(value)
    end

    local json = HttpService:JSONEncode(data)
    if writefile then
        writefile(Library.ConfigFolder .. "/" .. configName .. ".json", json)
        Library:Notify({ Title = "Config Saved", Text = "Saved: " .. configName .. ".json", Duration = 3 })
    else
        Library:Notify({ Title = "Executor Warning", Text = "writefile not supported", Duration = 3 })
    end
end

function Library:LoadConfig(configName)
    if not configName or configName == "" then return end
    local path = Library.ConfigFolder .. "/" .. configName .. ".json"
    if not (isfile and readfile and isfile(path)) then
        Library:Notify({ Title = "Config Error", Text = "Config not found!", Duration = 3 })
        return
    end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if ok and type(decoded) == "table" then
        for flag, rawVal in pairs(decoded) do
            local val = DeserializeValue(rawVal)
            Library.Flags[flag] = val
            if Library.FlagObjects[flag] and Library.FlagObjects[flag].Set then
                Library.FlagObjects[flag]:Set(val)
            end
        end
        Library:Notify({ Title = "Config Loaded", Text = "Loaded: " .. configName .. ".json", Duration = 3 })
    end
end

function Library:GetConfigList()
    EnsureConfigFolder()
    local list = {}
    if listfiles and isfolder and isfolder(Library.ConfigFolder) then
        for _, file in ipairs(listfiles(Library.ConfigFolder)) do
            local name = file:match("([^/\\]+)%.json$")
            if name then
                table.insert(list, name)
            end
        end
    end
    return list
end

