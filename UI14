    local function UpdateCorners(corners, w, h, col)
        local lenX, lenY = math.floor(w * 0.25), math.floor(h * 0.25)
        for _, c in ipairs(corners) do c.BackgroundColor3 = col; c.Visible = true end
        corners[1].Position = UDim2.fromOffset(0, 0); corners[1].Size = UDim2.fromOffset(lenX, 2)
        corners[2].Position = UDim2.fromOffset(0, 0); corners[2].Size = UDim2.fromOffset(2, lenY)
        corners[3].Position = UDim2.fromOffset(w - lenX, 0); corners[3].Size = UDim2.fromOffset(lenX, 2)
        corners[4].Position = UDim2.fromOffset(w - 2, 0); corners[4].Size = UDim2.fromOffset(2, lenY)
        corners[5].Position = UDim2.fromOffset(0, h - 2); corners[5].Size = UDim2.fromOffset(lenX, 2)
        corners[6].Position = UDim2.fromOffset(0, h - lenY); corners[6].Size = UDim2.fromOffset(2, lenY)
        corners[7].Position = UDim2.fromOffset(w - lenX, h - 2); corners[7].Size = UDim2.fromOffset(lenX, 2)
