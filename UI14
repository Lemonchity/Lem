        local enabled = Library.Flags["esp_enabled"] == true
        for plr, obj in pairs(PlayerObjects) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            local valid = enabled and char and hrp and hum
            if valid and Library.Flags["esp_deadcheck"] and hum.Health <= 0 then
                valid = false
            end
            if valid and Library.Flags["esp_teamcheck"] and plr.Team ~= nil and plr.Team == LocalPlayer.Team then
                valid = false
            end

            if not valid then
                obj.Holder.Visible = false
                if obj.Tracer then obj.Tracer.Visible = false end
                for _, b in ipairs(obj.Bones) do b.Visible = false end
                if SavedChams[plr] then
                    for part, orig in pairs(SavedChams[plr]) do
                        if part and part.Parent then
                            part.Material = orig.Material
                            part.Color = orig.Color
                        end
                    end
                    SavedChams[plr] = nil
                end
                continue
            end

            if Library.Flags["esp_chams"] then
                local chamsCol = Library.Flags["esp_chams_color"] or Library.Theme.Accent
                SavedChams[plr] = SavedChams[plr] or {}
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if not SavedChams[plr][part] then
                            SavedChams[plr][part] = { Material = part.Material, Color = part.Color }
                        end
                        part.Material = Enum.Material.ForceField
                        part.Color = chamsCol
                    end
                end
            elseif SavedChams[plr] then
                for part, orig in pairs(SavedChams[plr]) do
                    if part and part.Parent then
                        part.Material = orig.Material
                        part.Color = orig.Color
                    end
                end
                SavedChams[plr] = nil
            end

            local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                obj.Holder.Visible = false
                if obj.Tracer then obj.Tracer.Visible = false end
                for _, b in ipairs(obj.Bones) do b.Visible = false end
                continue
            end

            local topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
            local botPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))
            local height = math.max(18, math.abs(botPos.Y - topPos.Y))
            local width = math.max(12, height * 0.58)
            local x, y = rootPos.X - width / 2, topPos.Y

            obj.Holder.Visible = true
            obj.Holder.Position = UDim2.fromOffset(x, y)
            obj.Holder.Size = UDim2.fromOffset(width, height)

            local boxOn = Library.Flags["esp_box"] == true
            local boxCol = Library.Flags["esp_box_color"] or Library.Theme.Accent
            local boxMethod = Library.Flags["esp_box_method"] or "Normal"
            local fillOn = Library.Flags["esp_filled"] == true
            local fillCol = Library.Flags["esp_filled_color"] or Library.Theme.Accent

            obj.BoxFrame.BackgroundColor3 = fillCol:Lerp(Color3.new(1, 1, 1), 0.35)
            obj.BoxFrame.BackgroundTransparency = fillOn and 0.25 or 1

            if boxOn and boxMethod == "Normal" then
                obj.StrokeOuter.Enabled = true
                obj.StrokeInner.Enabled = true
                obj.StrokeInner.Color = boxCol
                for _, c in ipairs(obj.Corners) do c.Visible = false end
            elseif boxOn and boxMethod == "Corners" then
                obj.StrokeOuter.Enabled = false
                obj.StrokeInner.Enabled = false
                UpdateCorners(obj.Corners, width, height, boxCol)
            else
                obj.StrokeOuter.Enabled = false
                obj.StrokeInner.Enabled = false
                for _, c in ipairs(obj.Corners) do c.Visible = false end
            end

            local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local hpCol = GetHealthColor(hpRatio)
            obj.HpBg.Visible = Library.Flags["esp_hp_bar"] == true
            obj.HpFill.Size = UDim2.fromScale(1, hpRatio)
            obj.HpFill.BackgroundColor3 = hpCol

            obj.HpTxt.Visible = Library.Flags["esp_hp_text"] == true
            obj.HpTxt.Text = tostring(math.floor(hum.Health))
            obj.HpTxt.TextColor3 = hpCol
            obj.HpTxt.Position = UDim2.fromOffset(-34, math.clamp((1 - hpRatio) * height - 6, 0, height - 12))

            obj.NameLbl.Visible = Library.Flags["esp_nickname"] == true
            local tool = char:FindFirstChildOfClass("Tool")
            obj.ItemLbl.Visible = (Library.Flags["esp_item"] == true) and (tool ~= nil)
            if tool then
                obj.ItemLbl.Text = "[" .. tool.Name .. "]"
            end

            if obj.Tracer then
                if Library.Flags["esp_tracers"] then
                    local originMode = Library.Flags["esp_tracer_origin"] or "Bottom"
                    local startVec
                    if originMode == "Mouse" then
                        startVec = UserInputService:GetMouseLocation()
                    elseif originMode == "Top" then
                        startVec = Vector2.new(Camera.ViewportSize.X / 2, 0)
                    else
                        startVec = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    end
                    obj.Tracer.From = startVec
                    obj.Tracer.To = Vector2.new(rootPos.X, botPos.Y)
                    obj.Tracer.Color = Library.Flags["esp_tracer_color"] or Library.Theme.Accent
                    obj.Tracer.Visible = true
                else
                    obj.Tracer.Visible = false
                end
            end

            local skelOn = Library.Flags["esp_skeleton"] == true
            local bonePairs = (hum.RigType == Enum.HumanoidRigType.R15) and R15_Bones or R6_Bones
            local skelCol = Library.Flags["esp_skeleton_color"] or Color3.new(1, 1, 1)
            for idx, line in ipairs(obj.Bones) do
                local pair = bonePairs[idx]
                if skelOn and pair then
                    local p1 = char:FindFirstChild(pair[1])
                    local p2 = char:FindFirstChild(pair[2])
                    if p1 and p2 then
                        local v1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                        local v2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                        if vis1 and vis2 then
                            line.From = Vector2.new(v1.X, v1.Y)
                            line.To = Vector2.new(v2.X, v2.Y)
                            line.Color = skelCol
                            line.Visible = true
                            continue
                        end
                    end
                end
                line.Visible = false
            end
        end
    end)

    return EspTab
end

return Library