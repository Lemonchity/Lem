            draggingSV = false
            draggingHue = false
        end
    end)

    hexBox.FocusLost:Connect(function()
        local parsed = HexToColor3(hexBox.Text)
        if parsed then
            h, s, v = parsed:ToHSV()
            UpdateColor(true)
        else
            hexBox.Text = Color3ToHex(Color3.fromHSV(h, s, v))
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        moveConn:Disconnect()
        endConn:Disconnect()
        popup:Destroy()
        ActivePickerPopup = nil
    end)
end

