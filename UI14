    listHolder.BorderSizePixel = 0
    listHolder.ZIndex = 12
    listHolder.Parent = wrapper
    Instance.new("UICorner", listHolder).CornerRadius = UDim.new(0, 4)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Parent = listHolder

    local opened = false
    local DropdownObj = {}

    function DropdownObj:Set(val)
        Library.Flags[flag] = val
        mainBtn.Text = "  " .. tostring(val) .. "  v"
        callback(val)
    end

    function DropdownObj:Refresh(newItems)
        for _, child in ipairs(listHolder:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        listItems = newItems
        listHolder.Size = UDim2.new(0.53, 0, 0, #listItems * 22)

        for _, opt in ipairs(listItems) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 22)
            optBtn.BackgroundColor3 = Library.Theme.ElementBg
            optBtn.BackgroundTransparency = 0.3
            optBtn.BorderSizePixel = 0
            optBtn.Font = Enum.Font.Arcade
            optBtn.TextSize = 14
            optBtn.TextColor3 = Library.Theme.Text
            optBtn.Text = "  " .. tostring(opt)
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.ZIndex = 13
            optBtn.Parent = listHolder

            optBtn.MouseButton1Click:Connect(function()
                DropdownObj:Set(opt)
                opened = false
                Tween(wrapper, 0.2, { Size = UDim2.new(1, 0, 0, 26) })
            end)
        end
    end

    DropdownObj:Refresh(listItems)

    mainBtn.MouseButton1Click:Connect(function()
        opened = not opened
        local targetH = opened and (28 + #listItems * 22) or 26
        Tween(wrapper, 0.2, { Size = UDim2.new(1, 0, 0, targetH) })
    end)

    Library.FlagObjects[flag] = DropdownObj
    return DropdownObj
end

function Add:Textbox(section, options)
    options = options or {}
    local name = options.Name or "Textbox"
    local placeholder = options.Placeholder or "Type here..."
    local default = options.Default or ""
    local flag = options.Flag or name
    local callback = options.Callback or function() end

    Library.Flags[flag] = default

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 26)
    box.BackgroundColor3 = Library.Theme.ElementBg
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Arcade
    box.TextSize = 14
    box.TextColor3 = Library.Theme.Text
    box.PlaceholderColor3 = Library.Theme.SubText
    box.PlaceholderText = placeholder
    box.Text = default
    box.ClearTextOnFocus = false
    box.ZIndex = 8
    box.Parent = section.Container
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    local tbObj = {}
    function tbObj:Set(val)
        Library.Flags[flag] = val
        box.Text = tostring(val)
        callback(val)
    end

    box.FocusLost:Connect(function()
        Library.Flags[flag] = box.Text
        callback(box.Text)
    end)

    Library.FlagObjects[flag] = tbObj
    return tbObj
end

function Add:Button(section, options)
    options = options or {}
    local name = options.Name or "Button"
    local callback = options.Callback or function() end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 26)
    btn.BackgroundColor3 = Library.Theme.ElementBg
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 15
    btn.TextColor3 = Library.Theme.Text
    btn.Text = name
    btn.AutoButtonColor = false
    btn.ZIndex = 8
    btn.Parent = section.Container
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    btn.MouseEnter:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = Library.Theme.AccentDark })
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = Library.Theme.ElementBg })
    end)
    btn.MouseButton1Click:Connect(function()
        Tween(btn, 0.08, { BackgroundColor3 = Library.Theme.Accent })
        task.delay(0.1, function()
            Tween(btn, 0.15, { BackgroundColor3 = Library.Theme.ElementBg })
        end)
        callback()
    end)

    return btn
end

