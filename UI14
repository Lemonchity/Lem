            P_Name.Visible = Library.Flags["esp_nickname"] == true
            P_HpBg.Visible = Library.Flags["esp_hp_bar"] == true
            P_HpText.Visible = Library.Flags["esp_hp_text"] == true
            P_Item.Visible = Library.Flags["esp_item"] == true
