    checkBtn.BorderSizePixel = 0
    checkBtn.Font = Enum.Font.Arcade
    checkBtn.TextSize = 14
    checkBtn.TextColor3 = Color3.fromRGB(10, 15, 15)
    checkBtn.Text = state and "v" or ""
    checkBtn.AutoButtonColor = false
    checkBtn.ZIndex = 8
    checkBtn.Parent = row
    Instance.new("UICorner", checkBtn).CornerRadius = UDim.new(0, 3)

    local lbl = Instance.new("TextButton")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.fromOffset(24, 0)
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 15
    lbl.TextColor3 = state and Library.Theme.Text or Library.Theme.SubText
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = name
    lbl.ZIndex = 8
    lbl.Parent = row

    local addonsFrame = Instance.new("Frame")
    addonsFrame.BackgroundTransparency = 1
    addonsFrame.Position = UDim2.new(1, -85, 0, 0)
    addonsFrame.Size = UDim2.fromOffset(85, 22)
    addonsFrame.ZIndex = 8
    addonsFrame.Parent = row

    local addonsLayout = Instance.new("UIListLayout")
    addonsLayout.FillDirection = Enum.FillDirection.Horizontal
    addonsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    addonsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    addonsLayout.Padding = UDim.new(0, 5)
    addonsLayout.Parent = addonsFrame

    local ToggleObj = { Row = row, Addons = addonsFrame }

    function ToggleObj:Set(newState)
        state = newState
        Library.Flags[flag] = state
        checkBtn.Text = state and "v" or ""
        Tween(checkBtn, 0.18, {
            BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.ElementBg
        })
        Tween(lbl, 0.18, {
            TextColor3 = state and Library.Theme.Text or Library.Theme.SubText
        })
        callback(state)
    end

    local function OnClick()
        ToggleObj:Set(not state)
    end

    checkBtn.MouseButton1Click:Connect(OnClick)
    lbl.MouseButton1Click:Connect(OnClick)

    function ToggleObj:AddColorpicker(cpOpts)
        cpOpts = cpOpts or {}
        local cpDefault = cpOpts.Default or Library.Theme.Accent
        local cpFlag = cpOpts.Flag or (flag .. "_color")
        local cpCallback = cpOpts.Callback or function() end

        Library.Flags[cpFlag] = cpDefault

        local swatch = Instance.new("TextButton")
        swatch.Size = UDim2.fromOffset(22, 14)
        swatch.BackgroundColor3 = cpDefault
        swatch.BorderSizePixel = 0
        swatch.Text = ""
        swatch.AutoButtonColor = false
        swatch.ZIndex = 9
        swatch.Parent = addonsFrame
        Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 3)

        local cpObj = {}
        function cpObj:Set(newCol)
            Library.Flags[cpFlag] = newCol
            swatch.BackgroundColor3 = newCol
            cpCallback(newCol)
        end

        swatch.MouseButton1Click:Connect(function()
            OpenColorPickerPopup(swatch, Library.Flags[cpFlag], function(selectedCol)
                cpObj:Set(selectedCol)
            end)
        end)

        Library.FlagObjects[cpFlag] = cpObj
        return cpObj
    end

    function ToggleObj:AddKeybind(kbOpts)
        kbOpts = kbOpts or {}
        local kbDefault = kbOpts.Default or Enum.KeyCode.None
        local kbMode = kbOpts.Mode or "Toggle"
        local kbFlag = kbOpts.Flag or (flag .. "_bind")
        local kbCallback = kbOpts.Callback or function() end

        local currentKey = kbDefault
        local listening = false
        local activeHold = false
        Library.Flags[kbFlag] = currentKey

        local bindBtn = Instance.new("TextButton")
        bindBtn.Size = UDim2.fromOffset(48, 16)
        bindBtn.BackgroundColor3 = Library.Theme.ElementBg
        bindBtn.BorderSizePixel = 0
        bindBtn.Font = Enum.Font.Arcade
        bindBtn.TextSize = 12
        bindBtn.TextColor3 = Library.Theme.Text
        bindBtn.Text = "[" .. (currentKey.Name or "None") .. "]"
        bindBtn.ZIndex = 9
        bindBtn.Parent = addonsFrame
        Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 3)

        local kbObj = {}
        function kbObj:Set(newKey)
            currentKey = newKey
            Library.Flags[kbFlag] = currentKey
            bindBtn.Text = "[" .. (currentKey.Name or "None") .. "]"
        end

        function kbObj:GetState()
            if kbMode == "Hold" then return activeHold end
            return state
        end

        bindBtn.MouseButton1Click:Connect(function()
            listening = true
            bindBtn.Text = "[...]"
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if listening then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    kbObj:Set(input.KeyCode)
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    listening = false
                    kbObj:Set(input.UserInputType)
                end
                return
            end

            if gp or currentKey == Enum.KeyCode.None then return end
            if input.KeyCode == currentKey or input.UserInputType == currentKey then
                if kbMode == "Toggle" then
                    ToggleObj:Set(not state)
                elseif kbMode == "Hold" then
                    activeHold = true
                    ToggleObj:Set(true)
                end
                kbCallback(currentKey)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if kbMode == "Hold" and (input.KeyCode == currentKey or input.UserInputType == currentKey) then
                activeHold = false
                ToggleObj:Set(false)
            end
        end)

        Library.FlagObjects[kbFlag] = kbObj
        return kbObj
    end

    Library.FlagObjects[flag] = ToggleObj
    return ToggleObj
end

function add:Colorpicker(toggleObj, opts) return toggleObj:AddColorpicker(opts) end
function add:Keybind(toggleObj, opts) return toggleObj:AddKeybind(opts) end

function Add:Slider(section, options)
    options = options or {}
    local name = options.Name or "Slider"
    local min = options.Min or 0
    local max = options.Max or 100
    local default = math.clamp(options.Default or min, min, max)
    local flag = options.Flag or name
    local callback = options.Callback or function() end

    Library.Flags[flag] = default

    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(1, 0, 0, 34)
    holder.ZIndex = 7
    holder.Parent = section.Container

    local title = Instance.new("TextLabel")
