-- [ ARCADE HUB PREMIUM | LEMOON LIBRARY v4.0 ] --

local Library = {}  
Library.__index = Library

local TweenService = game:GetService("TweenService")  
local UserInputService = game:GetService("UserInputService")  
local Players = game:GetService("Players")  
local LocalPlayer = Players.LocalPlayer

local Theme = {  
    Background   = Color3.fromRGB(18, 18, 24),  
    Section      = Color3.fromRGB(26, 26, 34),  
    Element      = Color3.fromRGB(34, 34, 44),  
    Accent       = Color3.fromRGB(0, 255, 150),  
    AccentDim    = Color3.fromRGB(0, 140, 90),  
    Text         = Color3.fromRGB(230, 230, 230),  
    TextDim      = Color3.fromRGB(150, 150, 160),  
    Stroke       = Color3.fromRGB(60, 60, 75),  
}

local function Create(class, props, parent)  
    local obj = Instance.new(class)  
    for k, v in pairs(props) do obj[k] = v end  
    if parent then obj.Parent = parent end  
    return obj  
end

local function Corner(radius, obj)  
    Create("UICorner", { CornerRadius = UDim.new(0, radius) }, obj)  
end

local function Stroke(obj, thickness, color)  
    Create("UIStroke", {  
        Thickness = thickness or 1,  
        Color = color or Theme.Stroke,  
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,  
    }, obj)  
end

-- ====== ОКНО ======  
function Library.new(config)  
    local self = setmetatable({}, Library)  
    self.Tabs = {}  
    self.Elements = {}

    self.ScreenGui = Create("ScreenGui", {  
        Name = "ArcadeHub",  
        ResetOnSpawn = false,  
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,  
    }, game:GetService("CoreGui"))

    self.MainFrame = Create("Frame", {  
        Size = UDim2.new(0, config.Width or 520, 0, config.Height or 420),  
        Position = UDim2.new(0.5, -(config.Width or 520)/2, 0.5, -(config.Height or 420)/2),  
        BackgroundColor3 = Theme.Background,  
        BorderSizePixel = 0,  
        Active = true,  
    }, self.ScreenGui)  
    Corner(10, self.MainFrame)  
    Stroke(self.MainFrame, 2, Theme.Accent)

    -- Тайтл-бар  
    self.TitleBar = Create("Frame", {  
        Size = UDim2.new(1, 0, 0, 36),  
        BackgroundColor3 = Theme.Section,  
        BorderSizePixel = 0,  
    }, self.MainFrame)  
    Corner(10, self.TitleBar)

    self.TitleLabel = Create("TextLabel", {  
        Size = UDim2.new(1, -60, 1, 0),  
        Position = UDim2.new(0, 12, 0, 0),  
        BackgroundTransparency = 1,  
        Text = config.Title or "ARCADE HUB",  
        TextColor3 = Theme.Accent,  
        Font = Enum.Font.Arcade,  
        TextSize = 18,  
        TextXAlignment = Enum.TextXAlignment.Left,  
    }, self.TitleBar)

    self.CloseBtn = Create("TextButton", {  
        Size = UDim2.new(0, 28, 1, 0),  
        Position = UDim2.new(1, -34, 0, 0),  
        BackgroundTransparency = 1,  
        Text = "X",  
        TextColor3 = Color3.fromRGB(255, 80, 80),  
        Font = Enum.Font.Arcade,  
        TextSize = 16,  
    }, self.TitleBar)

    -- Драг  
    do  
        local dragging, dragStart, startPos  
        self.TitleBar.InputBegan:Connect(function(input)  
            if input.UserInputType == Enum.UserInputType.MouseButton1 then  
                dragging = true  
                dragStart = input.Position  
                startPos = self.MainFrame.Position  
            end  
        end)  
        UserInputService.InputChanged:Connect(function(input)  
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then  
                local delta = input.Position - dragStart  
                self.MainFrame.Position = UDim2.new(  
                    startPos.X.Scale, startPos.X.Offset + delta.X,  
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y  
                )  
            end  
        end)  
        UserInputService.InputEnded:Connect(function(input)  
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end  
        end)  
    end

    self.CloseBtn.MouseButton1Click:Connect(function()  
        self.ScreenGui.Enabled = not self.ScreenGui.Enabled  
    end)

    -- Переключение по RightControl  
    UserInputService.InputBegan:Connect(function(input, gP)  
        if not gP and input.KeyCode == Enum.KeyCode.RightControl then  
            self.ScreenGui.Enabled = not self.ScreenGui.Enabled  
        end  
    end)

    -- Сайдбар табов  
    self.Sidebar = Create("ScrollingFrame", {  
        Size = UDim2.new(0, 130, 1, -46),  
        Position = UDim2.new(0, 10, 0, 46),  
        BackgroundColor3 = Theme.Section,  
        BorderSizePixel = 0,  
        ScrollBarThickness = 3,  
        ScrollBarImageColor3 = Theme.Accent,  
        CanvasSize = UDim2.new(0, 0, 0, 0),  
    }, self.MainFrame)  
    Corner(8, self.Sidebar)  
    Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, self.Sidebar)  
    Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, self.Sidebar)

    -- Контент  
    self.Pages = Create("Frame", {  
        Size = UDim2.new(1, -160, 1, -56),  
        Position = UDim2.new(0, 150, 0, 46),  
        BackgroundTransparency = 1,  
    }, self.MainFrame)

    self.ActiveTab = nil  
    return self  
end

function Library:SetTitle(text)  
    self.TitleLabel.Text = text  
end

-- ====== ТАБ ======  
function Library:CreateTab(name)  
    local tab = { Name = name, Elements = {} }

    tab.TabBtn = Create("TextButton", {  
        Size = UDim2.new(1, 0, 0, 30),  
        BackgroundColor3 = Theme.Element,  
        Text = name,  
        TextColor3 = Theme.TextDim,  
        Font = Enum.Font.Arcade,  
        TextSize = 13,  
        BorderSizePixel = 0,  
    }, self.Sidebar)  
    Corner(6, tab.TabBtn)

    tab.Page = Create("ScrollingFrame", {  
        Size = UDim2.new(1, 0, 1, 0),  
        BackgroundTransparency = 1,  
        BorderSizePixel = 0,  
        ScrollBarThickness = 4,  
        ScrollBarImageColor3 = Theme.Accent,  
        Visible = false,  
        CanvasSize = UDim2.new(0, 0, 0, 0),  
    }, self.Pages)  
    Create("UIListLayout", {  
        Padding = UDim.new(0, 6),  
        SortOrder = Enum.SortOrder.LayoutOrder,  
        HorizontalAlignment = Enum.HorizontalAlignment.Left,  
    }, tab.Page)  
    Create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4) }, tab.Page)

    -- Колонки Left/Right  
    tab.LeftColumn = Create("ScrollingFrame", {  
        Size = UDim2.new(0.5, -8, 1, 0),  
        BackgroundColor3 = Theme.Section,  
        BorderSizePixel = 0,  
        ScrollBarThickness = 3,  
        ScrollBarImageColor3 = Theme.Accent,  
    }, tab.Page)  
    Corner(8, tab.LeftColumn)  
    Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, tab.LeftColumn)  
    Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tab.LeftColumn)

    tab.RightColumn = Create("ScrollingFrame", {  
        Size = UDim2.new(0.5, -8, 1, 0),  
        Position = UDim2.new(0.5, 8, 0, 0),  
        BackgroundColor3 = Theme.Section,  
        BorderSizePixel = 0,  
        ScrollBarThickness = 3,  
        ScrollBarImageColor3 = Theme.Accent,  
    }, tab.Page)  
    Corner(8, tab.RightColumn)  
    Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, tab.RightColumn)  
    Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tab.RightColumn)

    -- Автовысота канваса  
    for _, col in ipairs({tab.LeftColumn, tab.RightColumn}) do  
        local lay = col:FindFirstChildOfClass("UIListLayout")  
        lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()  
            col.CanvasSize = UDim2.new(0, 0, 0, lay.AbsoluteContentSize.Y + 16)  
        end)  
    end

    tab.TabBtn.MouseButton1Click:Connect(function()  
        self:SwitchTab(name)  
    end)

    self.Tabs[name] = tab  
    if not self.ActiveTab then self:SwitchTab(name) end  
    return tab  
end

function Library:GetTab(name)  
    local t = self.Tabs[name]  
    if not t then warn("Нигга, ты указал таб, которого не существует!") end  
    return t  
end

function Library:SwitchTab(name)  
    for n, t in pairs(self.Tabs) do  
        t.Page.Visible = (n == name)  
        t.TabBtn.BackgroundColor3 = (n == name) and Theme.AccentDim or Theme.Element  
        t.TabBtn.TextColor3 = (n == name) and Color3.fromRGB(0, 0, 0) or Theme.TextDim  
    end  
    self.ActiveTab = name  
end

local function getCol(tab, side)  
    if side == "Right" then return tab.RightColumn end  
    return tab.LeftColumn  
end

-- ====== ЗАГОЛОВОК СЕКЦИИ ======  
function Library:CreateSection(tabName, text, side)  
    local tab = self:GetTab(tabName); if not tab then return end  
    local sec = Create("TextLabel", {  
        Size = UDim2.new(1, 0, 0, 26),  
        BackgroundColor3 = Theme.Element,  
        Text = text,  
        TextColor3 = Theme.Accent,  
        Font = Enum.Font.Arcade,  
        TextSize = 14,  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, sec)  
end

-- ====== КНОПКА ======  
function Library:CreateButton(tabName, text, side, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    local btn = Create("TextButton", {  
        Size = UDim2.new(1, 0, 0, 32),  
        BackgroundColor3 = Theme.Element,  
        Text = text,  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 13,  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, btn)  
    Stroke(btn, 1)

    btn.MouseEnter:Connect(function()  
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.AccentDim }):Play()  
    end)  
    btn.MouseLeave:Connect(function()  
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Element }):Play()  
    end)  
    btn.MouseButton1Click:Connect(function()  
        pcall(callback)  
    end)  
    return btn  
end

-- ====== ТОГГЛ ======  
function Library:CreateToggle(tabName, text, side, default, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    local state = default or false

    local holder = Create("TextButton", {  
        Size = UDim2.new(1, 0, 0, 30),  
        BackgroundColor3 = Theme.Element,  
        Text = "",  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, holder)

    local label = Create("TextLabel", {  
        Size = UDim2.new(1, -50, 1, 0),  
        Position = UDim2.new(0, 10, 0, 0),  
        BackgroundTransparency = 1,  
        Text = text,  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 13,  
        TextXAlignment = Enum.TextXAlignment.Left,  
    }, holder)

    local pill = Create("Frame", {  
        Size = UDim2.new(0, 36, 0, 18),  
        Position = UDim2.new(1, -46, 0.5, -9),  
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),  
        BorderSizePixel = 0,  
    }, holder)  
    Corner(9, pill)  
    Stroke(pill, 1, Theme.Stroke)

    local ball = Create("Frame", {  
        Size = UDim2.new(0, 14, 0, 14),  
        Position = UDim2.new(0, 2, 0.5, -7),  
        BackgroundColor3 = Theme.TextDim,  
        BorderSizePixel = 0,  
    }, pill)  
    Corner(7, ball)

    local lastClick = 0  
    local function setState(v, silent)  
        state = v  
        local t = TweenInfo.new(0.15, Enum.EasingStyle.Back)  
        TweenService:Create(ball, t, {  
            Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)  
        }):Play()  
        TweenService:Create(ball, t, {  
            BackgroundColor3 = state and Theme.Accent or Theme.TextDim  
        }):Play()  
        TweenService:Create(pill, t, {  
            BackgroundColor3 = state and Theme.AccentDim or Color3.fromRGB(50, 50, 60)  
        }):Play()  
        if not silent and callback then pcall(callback, state) end  
    end

    holder.MouseButton1Click:Connect(function()  
        local now = tick()  
        if now - lastClick < 0.3 then return end -- защита от спама, нигга  
        lastClick = now  
        setState(not state)  
    end)

    setState(state, true)  
    return { Set = setState, Get = function() return state end }  
end

-- ====== СЛАЙДЕР ======  
function Library:CreateSlider(tabName, text, side, min, max, default, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    min, max, default = min or 0, max or 100, default or min

    local holder = Create("Frame", {  
        Size = UDim2.new(1, 0, 0, 50),  
        BackgroundColor3 = Theme.Element,  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, holder)

    local label = Create("TextLabel", {  
        Size = UDim2.new(1, -70, 0, 18),  
        Position = UDim2.new(0, 10, 0, 2),  
        BackgroundTransparency = 1,  
        Text = text,  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 12,  
        TextXAlignment = Enum.TextXAlignment.Left,  
    }, holder)

    local valLabel = Create("TextLabel", {  
        Size = UDim2.new(0, 60, 0, 18),  
        Position = UDim2.new(1, -68, 0, 2),  
        BackgroundTransparency = 1,  
        Text = tostring(default),  
        TextColor3 = Theme.Accent,  
        Font = Enum.Font.Arcade,  
        TextSize = 12,  
        TextXAlignment = Enum.TextXAlignment.Right,  
    }, holder)

    local bg = Create("Frame", {  
        Size = UDim2.new(1, -20, 0, 10),  
        Position = UDim2.new(0, 10, 0, 30),  
        BackgroundColor3 = Color3.fromRGB(45, 45, 55),  
        BorderSizePixel = 0,  
    }, holder)  
    Corner(5, bg)

    local fill = Create("Frame", {  
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),  
        BackgroundColor3 = Theme.Accent,  
        BorderSizePixel = 0,  
    }, bg)  
    Corner(5, fill)

    local dragging = false  
    local function setFromX(x)  
        local rel = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)  
        local value = math.floor(min + (max - min) * rel + 0.5)  
        fill.Size = UDim2.new(rel, 0, 1, 0)  
        valLabel.Text = tostring(value)  
        if callback then pcall(callback, value) end  
    end

    bg.InputBegan:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseButton1 then  
            dragging = true  
            setFromX(input.Position.X)  
        end  
    end)  
    UserInputService.InputChanged:Connect(function(input)  
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then  
            setFromX(input.Position.X)  
        end  
    end)  
    UserInputService.InputEnded:Connect(function(input)  
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end  
    end)  
    return { Set = function(v) callback(v); valLabel.Text = tostring(v) end }  
end

-- ====== ДРОПДАУН ======  
function Library:CreateDropdown(tabName, text, side, options, default, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    options = options or {}

    local holder = Create("Frame", {  
        Size = UDim2.new(1, 0, 0, 34),  
        BackgroundColor3 = Theme.Element,  
        BorderSizePixel = 0,  
        ZIndex = 5,  
    }, getCol(tab, side))  
    Corner(5, holder)

    local label = Create("TextLabel", {  
        Size = text and UDim2.new(0.4, 0, 1, 0) or UDim2.new(1, 0, 1, 0),  
        Position = text and UDim2.new(0, 10, 0, 0) or UDim2.new(0, 0, 0, 0),  
        BackgroundTransparency = 1,  
        Text = text or "",  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 12,  
        TextXAlignment = Enum.TextXAlignment.Left,  
        ZIndex = 5,  
    }, holder)

    local current = default or options[1]  
    local btn = Create("TextButton", {  
        Size = UDim2.new(text and 0.55 or 1, -14, 0, 26),  
        Position = UDim2.new(text and 0.42 or 0, 7, 0.5, -13),  
        BackgroundColor3 = Color3.fromRGB(45, 45, 58),  
        Text = "▼ " .. tostring(current),  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Code,  
        TextSize = 12,  
        BorderSizePixel = 0,  
        ZIndex = 5,  
    }, holder)  
    Corner(5, btn)  
    Stroke(btn, 1)

    -- Список живит в MainFrame, чтобы был поверх всего  
    local list = Create("Frame", {  
        Size = UDim2.new(0, btn.AbsoluteSize.X, 0, math.max(#options * 24, 24)),  
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),  
        BorderSizePixel = 0,  
        Visible = false,  
        ZIndex = 1000,  
    }, self.MainFrame)  
    Corner(5, list)  
    Stroke(list, 1, Theme.Accent)  
    Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

    local function updatePos()  
        list.Position = UDim2.new(  
            0, btn.AbsolutePosition.X - self.MainFrame.AbsolutePosition.X,  
            0, btn.AbsolutePosition.Y - self.MainFrame.AbsolutePosition.Y + btn.AbsoluteSize.Y  
        )  
    end

    local isOpen = false  
    local function refreshOptions()  
        for _, child in ipairs(list:GetChildren()) do  
            if child:IsA("TextButton") then child:Destroy() end  
        end  
        for i, opt in ipairs(options) do  
            local ob = Create("TextButton", {  
                Size = UDim2.new(1, 0, 0, 24),  
                BackgroundColor3 = (opt == current) and Theme.AccentDim or Color3.fromRGB(30, 30, 40),  
                Text = tostring(opt),  
                TextColor3 = Theme.Text,  
                Font = Enum.Font.Code,  
                TextSize = 12,  
                BorderSizePixel = 0,  
                ZIndex = 1000,  
                LayoutOrder = i,  
            }, list)  
            Corner(0, ob)  
            ob.MouseButton1Click:Connect(function()  
                current = opt  
                btn.Text = "▼ " .. tostring(opt)  
                list.Visible = false; isOpen = false  
                if callback then pcall(callback, opt) end  
            end)  
        end  
        list.Size = UDim2.new(0, btn.AbsoluteSize.X, 0, #options * 24)  
        updatePos()  
    end  
    refreshOptions()

    btn.MouseButton1Click:Connect(function()  
        isOpen = not isOpen  
        list.Visible = isOpen  
        if isOpen then updatePos() end  
    end)  
    return { Set = function(v) current = v; btn.Text = "▼ " .. tostring(v); refreshOptions(); if callback then pcall(callback, v) end end }  
end

-- ====== КЕЙБИНД ======  
function Library:CreateKeybind(tabName, text, side, defaultKey, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    local keyName = defaultKey or "None"

    local holder = Create("TextButton", {  
        Size = UDim2.new(1, 0, 0, 30),  
        BackgroundColor3 = Theme.Element,  
        Text = "",  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, holder)

    Create("TextLabel", {  
        Size = UDim2.new(1, -80, 1, 0),  
        Position = UDim2.new(0, 10, 0, 0),  
        BackgroundTransparency = 1,  
        Text = text,  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 12,  
        TextXAlignment = Enum.TextXAlignment.Left,  
    }, holder)

    local keyLabel = Create("TextLabel", {  
        Size = UDim2.new(0, 70, 1, 0),  
        Position = UDim2.new(1, -80, 0, 0),  
        BackgroundTransparency = 1,  
        Text = "[" .. keyName .. "]",  
        TextColor3 = Theme.Accent,  
        Font = Enum.Font.Code,  
        TextSize = 12,  
        TextXAlignment = Enum.TextXAlignment.Right,  
    }, holder)

    local listening = false  
    holder.MouseButton1Click:Connect(function()  
        listening = true  
        keyLabel.Text = "[...]"  
    end)

    UserInputService.InputBegan:Connect(function(input, gP)  
        if not gP then  
            if listening and input.UserInputType == Enum.UserInputType.Keyboard then  
                keyName = input.KeyCode.Name  
                keyLabel.Text = "[" .. keyName .. "]"  
                listening = false  
            elseif keyName ~= "None" and not listening and input.KeyCode.Name == keyName then  
                if callback then pcall(callback) end  
            end  
        end  
    end)  
    return { GetKey = function() return keyName end }  
end

-- ====== ЦВЕТПИКЕР (пресеты) ======  
function Library:CreateColorPicker(tabName, text, side, defaultColor, callback)  
    local tab = self:GetTab(tabName); if not tab then return end  
    local presets = {  
        Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 150), Color3.fromRGB(0, 170, 255),  
        Color3.fromRGB(255, 255, 0), Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255),  
        Color3.fromRGB(0, 0, 0),  
    }

    local holder = Create("Frame", {  
        Size = UDim2.new(1, 0, 0, 40),  
        BackgroundColor3 = Theme.Element,  
        BorderSizePixel = 0,  
    }, getCol(tab, side))  
    Corner(5, holder)

    Create("TextLabel", {  
        Size = UDim2.new(1, -14, 0, 16),  
        Position = UDim2.new(0, 8, 0, 2),  
        BackgroundTransparency = 1,  
        Text = text,  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 11,  
        TextXAlignment = Enum.TextXAlignment.Left,  
    }, holder)

    local current = defaultColor or presets[2]  
    local preview = Create("TextButton", {  
        Size = UDim2.new(0, 60, 0, 16),  
        Position = UDim2.new(0, 8, 0, 20),  
        BackgroundColor3 = current,  
        Text = "",  
        BorderSizePixel = 0,  
        ZIndex = 500,  
    }, holder)  
    Corner(5, preview)  
    Stroke(preview, 1)

    local list = Create("Frame", {  
        Size = UDim2.new(0, 60, 0, #presets * 20),  
        Position = UDim2.new(0, 8, 0, 38),  
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),  
        BorderSizePixel = 0,  
        Visible = false,  
        ZIndex = 1000,  
    }, holder)  
    Corner(5, list)  
    Stroke(list, 1, Theme.Accent)  
    Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

    for i, c in ipairs(presets) do  
        local cb = Create("TextButton", {  
            Size = UDim2.new(1, 0, 0, 20),  
            BackgroundColor3 = c,  
            Text = "",  
            BorderSizePixel = 0,  
            ZIndex = 1000,  
            LayoutOrder = i,  
        }, list)  
        cb.MouseButton1Click:Connect(function()  
            current = c  
            preview.BackgroundColor3 = c  
            list.Visible = false  
            if callback then pcall(callback, c) end  
        end)  
    end

    preview.MouseButton1Click:Connect(function()  
        list.Visible = not list.Visible  
    end)  
    return { Get = function() return current end }  
end

-- ====== НОТИФИКАЦИИ ======  
Library.Notifications = {}

function Library:Notify(text, duration)  
    duration = duration or 3  
    local gui = self.ScreenGui

    local notif = Create("Frame", {  
        Size = UDim2.new(0, 280, 0, 50),  
        Position = UDim2.new(0.5, -140, 0.55, #self.Notifications * 55),  
        BackgroundColor3 = Theme.Section,  
        BorderSizePixel = 0,  
        ZIndex = 2000,  
    }, gui)  
    Corner(8, notif)  
    Stroke(notif, 2, Theme.Accent)

    local label = Create("TextLabel", {  
        Size = UDim2.new(1, -20, 1, 0),  
        Position = UDim2.new(0, 10, 0, 0),  
        BackgroundTransparency = 1,  
        Text = "",  
        TextColor3 = Theme.Text,  
        Font = Enum.Font.Arcade,  
        TextSize = 12,  
        TextWrapped = true,  
        ZIndex = 2000,  
    }, notif)

    -- Конфететная типизация текста, nigga  
    task.spawn(function()  
        for i = 1, #text do  
            label.Text = string.sub(text, 1, i)  
            task.wait(0.02)  
        end  
        task.wait(duration)  
        TweenService:Create(notif, TweenInfo.new(0.4), {  
            Position = UDim2.new(-0.5, 0, notif.Position.Y.Scale, notif.Position.Y.Offset),  
            Transparency = 1,  
        }):Play()  
        task.wait(0.45)  
        notif:Destroy()  
        -- Сдвигаем остальные наверх  
        for i, n in ipairs(self.Notifications) do  
            if n and n.Parent then  
                TweenService:Create(n, TweenInfo.new(0.3), {  
                    Position = UDim2.new(0.5, -140, 0.55, (i - 1) * 55),  
                }):Play()  
            end  
        end  
    end)  
    table.insert(self.Notifications, notif)  
end

return Library  
