local Library, Create = loadstring(game:HttpGet("LINK"))()

local Window = Create:Window({
    Name = "Lol",                       l
    Subtitle = "By lemonchity",    
    Keybind = Enum.KeyCode.RightControl,
    Image = "rbxassetid://7733960981"
})

local Watermark = Library:Watermark({
    Image = "rbxassetid://7733960981",
    Text = "Lol | LemonchityDLC | 60 FPS"  
})

Library:Notify({
    Title = "Success",
    Text = "Script loaded successfully!",
    Duration = 4
})

Window:AddSection({
    Name = "combat"
})

local MainTab = Window:AddTab({
    Name = "Aimbot"
})

local LeftGroup = MainTab:AddGroupbox({
    Name = "Main Settings",
    Side = "Left"
})

local RightGroup = MainTab:AddGroupbox({
    Name = "Visuals",
    Side = "Right"
})

local AimToggle = LeftGroup:Toggle({
    Name = "Enable Aimbot",
    Default = false,
    Flag = "aimbot_enabled",
    Callback = function(Value)
        print("Aimbot state:", Value)
    end
})

LeftGroup:Slider({
    Name = "FOV Radius",
    Min = 0,
    Max = 50,
    Default = 25,
    Flag = "aimbot_fov",
    Callback = function(Value)
        print("FOV:", Value)
    end
})

LeftGroup:Dropdown({
    Name = "Target Part",
    Options = {"Head", "Torso", "HumanoidRootPart"},
    Default = "Head",
    Flag = "aimbot_part",
    Callback = function(Selected)
        print("Selected part:", Selected)
    end
})

LeftGroup:Textbox({
    Name = "Target Player",
    Placeholder = "Enter nickname...",
    Default = "",
    Flag = "target_nick",
    Callback = function(Text)
        print("Entered text:", Text)
    end
})

LeftGroup:Button({
    Name = "Reset Settings",
    Callback = function()
        Library:Notify({
            Title = "Info",
            Text = "Settings have been reset.",
            Duration = 3
        })
    end
})

local StatusLabel = LeftGroup:Label("Status: Idle")
StatusLabel:SetText("Status: Active")

local EspToggle = RightGroup:Toggle({
    Name = "Toggle with CP",
    Default = true,
    Flag = "esp_box",
    Callback = function(State)
        print("ESP:", State)
    end
})

EspToggle:AddColorpicker({
    Default = Color3.fromRGB(0, 170, 255),
    Flag = "esp_box_color",
    Callback = function(Color)
        print("New color:", Color)
    end
})

local SpeedToggle = LeftGroup:Toggle({
    Name = "Speedhack",
    Default = false,
    Flag = "speed_enabled",
    Callback = function(State)
        print("Speedhack active:", State)
    end
})

SpeedToggle:AddKeybind({
    Default = Enum.KeyCode.LeftShift,
    Mode = "Hold",
    Flag = "speed_bind"
})

Window:AddConfigManager("MyScriptConfigs")