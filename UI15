                Padding = UDim.new(0, 6)
            })
        })

        local switchBg = Create("TextButton", {
            Parent = rightAddons,
            Size = UDim2.new(0, 36, 0, 18),
            BackgroundColor3 = state and Library.Theme.AccentDark or Library.Theme.Background,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = 10,
            ZIndex = 17
        }, {
            Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        local knob = Create("Frame", {
            Parent = switchBg,
            Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
            Size = UDim2.new(0, 14, 0, 14),
            BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.SubText,
            ZIndex = 18
        }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

        local function SetState(newState)
            state = newState
            Tween(switchBg, TweenInfo.new(0.18), {
                BackgroundColor3 = state and Library.Theme.AccentDark or Library.Theme.Background
            })
            Tween(knob, TweenInfo.new(0.18), {
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.SubText
            })
            if flag then Library.Flags[flag] = state end
            if cb then cb(state) end
        end

        clickBtn.MouseButton1Click:Connect(function() SetState(not state) end)
        switchBg.MouseButton1Click:Connect(function() SetState(not state) end)

        if flag then
            Library.Flags[flag] = state
            Library.FlagObjects[flag] = { Type = "Toggle", Set = SetState }
        end

        local ToggleObj = { Set = SetState }

        function ToggleObj:AddColorpicker(cpOpts)
            cpOpts = cpOpts or {}
            local curColor = cpOpts.Default or cpOpts.default or Library.Theme.Accent
            local cpFlag = cpOpts.Flag or cpOpts.flag
            local cpCb = cpOpts.Callback or cpOpts.callback

            local cpBtn = Create("TextButton", {
                Parent = rightAddons,
                Size = UDim2.new(0, 20, 0, 18),
                BackgroundColor3 = curColor,
                Text = "",
                AutoButtonColor = false,
                LayoutOrder = 1,
                ZIndex = 17
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                Create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 })
            })

            local function SetColor(c)
                curColor = c
                cpBtn.BackgroundColor3 = c
                if cpFlag then Library.Flags[cpFlag] = "#" .. c:ToHex() end
                if cpCb then cpCb(c) end
            end

            cpBtn.MouseButton1Click:Connect(function()
                OpenColorPicker(curColor, SetColor, function(c) cpBtn.BackgroundColor3 = c end)
            end)

            if cpFlag then
                Library.Flags[cpFlag] = "#" .. curColor:ToHex()
                Library.FlagObjects[cpFlag] = {
                    Type = "Colorpicker",
                    Set = function(hex)
                        local ok, parsed = pcall(function() return Color3.fromHex(hex:gsub("#", "")) end)
                        if ok and parsed then SetColor(parsed) end
                    end
                }
            end
            return ToggleObj
        end

        function ToggleObj:AddKeybind(kbOpts)
            kbOpts = kbOpts or {}
            local curKey = kbOpts.Default or kbOpts.default or Enum.KeyCode.Unknown
            local binding = false
            local kbName = kbOpts.Name or kbOpts.name or opts.Name or opts.name or "Bind"
            local kbCb = kbOpts.Callback or kbOpts.callback

            local kbBtn = Create("TextButton", {
                Parent = rightAddons,
                Size = UDim2.new(0, 44, 0, 18),
                BackgroundColor3 = Library.Theme.Background,
                Font = Enum.Font.Arcade,
                Text = curKey == Enum.KeyCode.Unknown and "[None]" or "[" .. curKey.Name .. "]",
                TextColor3 = Library.Theme.SubText,
                TextSize = 11,
                LayoutOrder = 2,
                ZIndex = 17
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
            })

            local bindEntry = { Name = kbName, Key = curKey, State = state }
            table.insert(Library.Keybinds, bindEntry)

            kbBtn.MouseButton1Click:Connect(function()
                binding = true
                kbBtn.Text = "[...]"
                kbBtn.TextColor3 = Library.Theme.Accent
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if binding and inp.UserInputType == Enum.UserInputType.Keyboard then
                    binding = false
                    curKey = inp.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or inp.KeyCode
                    bindEntry.Key = curKey
                    kbBtn.Text = curKey == Enum.KeyCode.Unknown and "[None]" or "[" .. curKey.Name .. "]"
                    kbBtn.TextColor3 = Library.Theme.SubText
                elseif not gpe and not binding and curKey ~= Enum.KeyCode.Unknown and inp.KeyCode == curKey then
                    SetState(not state)
                    bindEntry.State = state
                    if kbCb then kbCb(state) end
                end
            end)

            return ToggleObj
        end

        return ToggleObj
    end

    return Builder
end

