            Create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
            Create("UIListLayout", { Padding = UDim.new(0, 8) })
        })

        local L = AttachElementBuilders(leftCol)
        local R = AttachElementBuilders(rightCol)

        L:Label({ Text = "Configuration (JSON)", Color = Library.Theme.Accent })
        local cfgName = "default"
        L:Textbox({
            Name = "Config Name",
            Default = "default",
            Callback = function(v) cfgName = v end
        })

        L:Button({
            Name = "Save Config",
            Callback = function()
                if writefile then
                    if makefolder and isfolder and not isfolder(Library.Folder) then
                        makefolder(Library.Folder)
                    end
                    local json = HttpService:JSONEncode(Library.Flags)
                    writefile(Library.Folder .. "/" .. cfgName .. ".json", json)
                    Library:Notify({ Title = "Config Saved", Text = "Saved: " .. cfgName .. ".json", Duration = 3 })
                else
                    Library:Notify({ Title = "Error", Text = "Filesystem API not supported", Duration = 3 })
                end
            end
        })

        L:Button({
            Name = "Load Config",
            Callback = function()
                local path = Library.Folder .. "/" .. cfgName .. ".json"
                if readfile and isfile and isfile(path) then
                    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
                    if ok and type(decoded) == "table" then
                        for k, v in pairs(decoded) do
                            if Library.FlagObjects[k] then
                                Library.FlagObjects[k].Set(v)
                            end
                        end
                        Library:Notify({ Title = "Config Loaded", Text = "Loaded: " .. cfgName .. ".json", Duration = 3 })
                    end
                else
                    Library:Notify({ Title = "Error", Text = "Config file not found", Duration = 3 })
                end
            end
        })

        R:Label({ Text = "UI Theme Colors", Color = Library.Theme.Accent })

        local function AddThemePicker(label, key)
            local tgl = R:Toggle({ Name = label, Default = true })
            tgl:AddColorpicker({
                Default = Library.Theme[key],
                Callback = function(col)
                    Library.Theme[key] = col
                    for _, item in ipairs(Library.ThemeObjects) do
                        if item.Key == key and item.Object then
                            item.Object[item.Property] = col
                        end
                    end
                end
            })
        end

        AddThemePicker("Accent Color", "Accent")
        AddThemePicker("Background Color", "Background")
        AddThemePicker("Topbar Color", "Topbar")
        AddThemePicker("Text Color", "Text")

        L:Label({ Text = "Active Keybinds", Color = Library.Theme.Accent })
        local kbListLabel = L:Label({ Text = "No binds set", Color = Library.Theme.SubText })
        RunService.Heartbeat:Connect(function()
            if not tabFrame.Visible then return end
            local lines = {}
            for _, b in ipairs(Library.Keybinds) do
                if b.Key ~= Enum.KeyCode.Unknown then
                    table.insert(lines, string.format("[%s] %s", b.Key.Name, b.Name))
                end
            end
            kbListLabel:SetText(#lines > 0 and table.concat(lines, "\n") or "No active binds")
        end)
    end

