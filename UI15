local function AttachElementBuilders(container)
    local Builder = {}

    function Builder:Label(opts)
        opts = opts or {}
        local lbl = Create("TextLabel", {
            Parent = container,
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = opts.Text or opts.text or "Label",
            TextColor3 = opts.Color or opts.color or Library.Theme.SubText,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 15
        })
        return {
            SetText = function(_, t) lbl.Text = t end,
            SetColor = function(_, c) lbl.TextColor3 = c end
        }
    end

    function Builder:Button(opts)
        opts = opts or {}
        local cb = opts.Callback or opts.callback
        local btn = Create("TextButton", {
            Parent = container,
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Library.Theme.Element,
            Font = Enum.Font.Arcade,
            Text = opts.Name or opts.name or "Button",
            TextColor3 = Library.Theme.Text,
            TextSize = 14,
            AutoButtonColor = false,
            ZIndex = 15
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        btn.MouseEnter:Connect(function()
            Tween(btn, TweenInfo.new(0.15), { BackgroundColor3 = Library.Theme.ElementHover })
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, TweenInfo.new(0.15), { BackgroundColor3 = Library.Theme.Element })
        end)
        btn.MouseButton1Click:Connect(function()
            Tween(btn, TweenInfo.new(0.08), { BackgroundColor3 = Library.Theme.AccentDark })
            task.wait(0.08)
            Tween(btn, TweenInfo.new(0.15), { BackgroundColor3 = Library.Theme.ElementHover })
            if cb then cb() end
        end)
        return btn
    end

    function Builder:Textbox(opts)
        opts = opts or {}
        local flag = opts.Flag or opts.flag
        local def = opts.Default or opts.default or ""
        local cb = opts.Callback or opts.callback

        local holder = Create("Frame", {
            Parent = container,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Theme.Element,
            ZIndex = 15
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        Create("TextLabel", {
            Parent = holder,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(0.48, 0, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = opts.Name or opts.name or "Input",
            TextColor3 = Library.Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 16
        })

        local box = Create("TextBox", {
            Parent = holder,
            Position = UDim2.new(0.5, 0, 0.5, -11),
            Size = UDim2.new(0.48, -8, 0, 22),
            BackgroundColor3 = Library.Theme.Background,
            Font = Enum.Font.Arcade,
            Text = def,
            PlaceholderText = opts.Placeholder or opts.placeholder or "...",
            TextColor3 = Library.Theme.Accent,
            TextSize = 13,
            ClearTextOnFocus = false,
            ZIndex = 16
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        local function SetVal(v)
            box.Text = tostring(v)
            if flag then Library.Flags[flag] = box.Text end
            if cb then cb(box.Text) end
        end

        box.FocusLost:Connect(function() SetVal(box.Text) end)
        if flag then
            Library.Flags[flag] = def
            Library.FlagObjects[flag] = { Type = "Textbox", Set = SetVal }
        end
        return { Set = SetVal }
    end

    function Builder:Slider(opts)
        opts = opts or {}
        local min = opts.Min or opts.min or 0
        local max = opts.Max or opts.max or 100
        local decimals = opts.Decimals or opts.decimals or 0
        local flag = opts.Flag or opts.flag
        local cb = opts.Callback or opts.callback
        local value = math.clamp(opts.Default or opts.default or min, min, max)

        local holder = Create("Frame", {
            Parent = container,
            Size = UDim2.new(1, 0, 0, 44),
            BackgroundColor3 = Library.Theme.Element,
            ZIndex = 15
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        Create("TextLabel", {
            Parent = holder,
            Position = UDim2.new(0, 10, 0, 4),
            Size = UDim2.new(0.7, 0, 0, 18),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = opts.Name or opts.name or "Slider",
            TextColor3 = Library.Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 16
        })

        local valLbl = Create("TextLabel", {
            Parent = holder,
            Position = UDim2.new(0.7, 0, 0, 4),
            Size = UDim2.new(0.3, -10, 0, 18),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = tostring(value),
            TextColor3 = Library.Theme.Accent,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 16
        })

        local track = Create("TextButton", {
            Parent = holder,
            Position = UDim2.new(0, 10, 0, 28),
            Size = UDim2.new(1, -20, 0, 8),
            BackgroundColor3 = Library.Theme.Background,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 16
        }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

        local fill = Create("Frame", {
            Parent = track,
            Size = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 1, 0),
            BackgroundColor3 = Library.Theme.Accent,
            ZIndex = 17
        }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

        local function SetVal(newVal)
            local mult = 10 ^ decimals
            newVal = math.floor(math.clamp(newVal, min, max) * mult + 0.5) / mult
            value = newVal
            valLbl.Text = tostring(value)
            local pct = (value - min) / math.max(max - min, 0.0001)
            Tween(fill, TweenInfo.new(0.08), { Size = UDim2.new(pct, 0, 1, 0) })
            if flag then Library.Flags[flag] = value end
            if cb then cb(value) end
        end

        local dragging = false
        local function UpdateFromInput(inp)
            local pct = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            SetVal(min + (max - min) * pct)
        end

        track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                UpdateFromInput(inp)
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(inp)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        if flag then
            Library.Flags[flag] = value
            Library.FlagObjects[flag] = { Type = "Slider", Set = SetVal }
        end
        return { Set = SetVal }
    end

    -- ==========================================
    -- DROPDOWN (ПОДДЕРЖКА MULTI + LIMIT)
    -- ==========================================
    function Builder:Dropdown(opts)
        opts = opts or {}
        local items = opts.Items or opts.items or {}
        local flag = opts.Flag or opts.flag
        local cb = opts.Callback or opts.callback
        local isMulti = (opts.Multi == true) or (opts.multi == true)
        local limit = opts.Limit or opts.limit -- число (например, limit = 1) или nil (без лимита)
        local opened = false

        local selectedSingle = opts.Default or opts.default or items[1] or "None"
        local selectedMulti = {}

        if isMulti then
            local def = opts.Default or opts.default
            if type(def) == "table" then
                for _, v in ipairs(def) do
                    if not limit or #selectedMulti < limit then
                        table.insert(selectedMulti, v)
                    end
                end
            elseif def ~= nil then
                table.insert(selectedMulti, def)
            end
        end

        local holder = Create("Frame", {
            Parent = container,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Theme.Element,
            ClipsDescendants = true,
            ZIndex = 16
        }, {
            Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            Create("UIStroke", { Color = Library.Theme.Border, Thickness = 1 })
        })

        local headerBtn = Create("TextButton", {
            Parent = holder,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 17
        })

        Create("TextLabel", {
            Parent = headerBtn,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(0.45, 0, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = opts.Name or opts.name or "Dropdown",
            TextColor3 = Library.Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 18
        })

        local selectedLbl = Create("TextLabel", {
            Parent = headerBtn,
            Position = UDim2.new(0.45, 0, 0, 0),
            Size = UDim2.new(0.55, -10, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = "",
            TextColor3 = Library.Theme.Accent,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 18
        })

        local listFrame = Create("Frame", {
            Parent = holder,
            Position = UDim2.new(0, 6, 0, 36),
            Size = UDim2.new(1, -12, 0, #items * 26),
            BackgroundTransparency = 1,
            ZIndex = 17
        }, {
            Create("UIListLayout", { Padding = UDim.new(0, 3) })
        })

        local itemButtons = {}

        local function IsSelected(item)
            if isMulti then
                return table.find(selectedMulti, item) ~= nil
            else
                return selectedSingle == item
            end
        end

        local function RefreshVisuals()
            local arrow = opened and " ^" or " v"
            if isMulti then
                local display = #selectedMulti > 0 and table.concat(selectedMulti, ", ") or "None"
                if limit then
                    selectedLbl.Text = string.format("%s (%d/%d)%s", display, #selectedMulti, limit, arrow)
                else
                    selectedLbl.Text = display .. arrow
                end
            else
                selectedLbl.Text = tostring(selectedSingle) .. arrow
            end

            for item, btn in pairs(itemButtons) do
                local active = IsSelected(item)
                btn.BackgroundColor3 = active and Library.Theme.AccentDark or Library.Theme.Background
                btn.TextColor3 = active and Library.Theme.Accent or Library.Theme.Text
            end
        end

        local function SetVal(val)
            if isMulti then
                selectedMulti = {}
                if type(val) == "table" then
                    for _, v in ipairs(val) do
                        if not limit or #selectedMulti < limit then
                            table.insert(selectedMulti, v)
                        end
                    end
                elseif val ~= nil then
                    table.insert(selectedMulti, val)
                end
                RefreshVisuals()
                if flag then Library.Flags[flag] = selectedMulti end
                if cb then cb(selectedMulti) end
            else
                selectedSingle = val
                RefreshVisuals()
                if flag then Library.Flags[flag] = selectedSingle end
                if cb then cb(selectedSingle) end
            end
        end

        for _, item in ipairs(items) do
            local itBtn = Create("TextButton", {
                Parent = listFrame,
                Size = UDim2.new(1, 0, 0, 23),
                BackgroundColor3 = Library.Theme.Background,
                Font = Enum.Font.Arcade,
                Text = tostring(item),
                TextColor3 = Library.Theme.Text,
                TextSize = 13,
                AutoButtonColor = false,
                ZIndex = 18
            }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })

            itemButtons[item] = itBtn

            itBtn.MouseButton1Click:Connect(function()
                if isMulti then
                    local idx = table.find(selectedMulti, item)
                    if idx then
                        table.remove(selectedMulti, idx)
                    else
                        if limit and #selectedMulti >= limit then
                            if limit == 1 then
                                -- При limit = 1 плавно заменяем текущий выбор на новый
                                selectedMulti = { item }
                            else
                                Library:Notify({
                                    Title = "Limit Reached",
                                    Text = "Max " .. tostring(limit) .. " option(s) allowed.",
                                    Duration = 2
                                })
                                return
                            end
                        else
                            table.insert(selectedMulti, item)
                        end
                    end
                    RefreshVisuals()
                    if flag then Library.Flags[flag] = selectedMulti end
                    if cb then cb(selectedMulti) end
                else
                    opened = false
                    SetVal(item)
                    Tween(holder, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 34) })
                end
            end)
        end

        headerBtn.MouseButton1Click:Connect(function()
            opened = not opened
            RefreshVisuals()
            local targetH = opened and (42 + #items * 26) or 34
            Tween(holder, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, targetH) })
        end)

        RefreshVisuals()

        if flag then
            Library.Flags[flag] = isMulti and selectedMulti or selectedSingle
            Library.FlagObjects[flag] = { Type = "Dropdown", Set = SetVal }
        end

        return {
            Set = SetVal,
            Get = function() return isMulti and selectedMulti or selectedSingle end
        }
    end

    function Builder:Toggle(opts)
        opts = opts or {}
