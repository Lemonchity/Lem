local ActiveNotifications = {}

local function RepositionNotifications()
    local yOffset = 0
    for i = #ActiveNotifications, 1, -1 do
        local notif = ActiveNotifications[i]
        if notif and notif.Frame and notif.Frame.Parent then
            Tween(notif.Frame, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0.56, yOffset)
            })
            yOffset = yOffset + notif.Frame.Size.Y.Offset + 8
        end
    end
end

function Library:Notify(opts)
    opts = opts or {}
    local title = opts.Title or opts.title or "Notification"
    local text = opts.Text or opts.text or ""
    local duration = opts.Duration or opts.duration or 4

    local frame = Create("Frame", {
        Parent = ScreenGui,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.56, -20),
        Size = UDim2.new(0, 310, 0, 56),
        BackgroundColor3 = Library.Theme.Background,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 100
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 6) })
    })
    AddSnakeStroke(frame, 1.4)

    local glow = Create("ImageLabel", {
        Parent = frame,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1.2, 0, 1.5, 0),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084",
        ImageColor3 = Library.Theme.Accent,
        ImageTransparency = 0.85,
        ZIndex = 100
    })

    local titleLbl = Create("TextLabel", {
        Parent = frame,
        Position = UDim2.new(0, 12, 0, 6),
        Size = UDim2.new(1, -24, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.Arcade,
        Text = title,
        TextColor3 = Library.Theme.Accent,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101
    })

    local bodyLbl = Create("TextLabel", {
        Parent = frame,
        Position = UDim2.new(0, 12, 0, 25),
        Size = UDim2.new(1, -24, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.Arcade,
        Text = "",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 101
    })

    local timerBg = Create("Frame", {
        Parent = frame,
        Position = UDim2.new(0, 0, 1, -3),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Library.Theme.Element,
        BorderSizePixel = 0,
        ZIndex = 101
    })

    local timerFill = Create("Frame", {
        Parent = timerBg,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Library.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 102
    })

    local entry = { Frame = frame }
    table.insert(ActiveNotifications, entry)
    RepositionNotifications()

    Tween(frame, TweenInfo.new(0.25), { BackgroundTransparency = 0.08 })
    Tween(timerFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })

    task.spawn(function()
        for i = 1, #text do
            if not bodyLbl or not bodyLbl.Parent then break end
            bodyLbl.Text = string.sub(text, 1, i)
            task.wait(0.022)
        end
    end)

    task.delay(duration, function()
        for idx, item in ipairs(ActiveNotifications) do
            if item == entry then
                table.remove(ActiveNotifications, idx)
                break
            end
        end
        RepositionNotifications()
        Tween(frame, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
        Tween(titleLbl, TweenInfo.new(0.25), { TextTransparency = 1 })
        Tween(bodyLbl, TweenInfo.new(0.25), { TextTransparency = 1 })
        Tween(glow, TweenInfo.new(0.25), { ImageTransparency = 1 })
        task.wait(0.26)
        if frame then frame:Destroy() end
    end)
end

