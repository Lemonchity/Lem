local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local FONT = Enum.Font.Arcade

local Theme = {
    Background = Color3.fromRGB(18, 20, 28),
    Header = Color3.fromRGB(28, 30, 42),
    TabBar = Color3.fromRGB(24, 26, 38),
    TabInactive = Color3.fromRGB(32, 35, 48),
    TabActive = Color3.fromRGB(55, 100, 235),
    SidePanel = Color3.fromRGB(24, 26, 38),
    ComponentBg = Color3.fromRGB(32, 35, 48),
    ToggleOff = Color3.fromRGB(50, 52, 68),
    ToggleOn = Color3.fromRGB(55, 100, 235),
    Knob = Color3.fromRGB(255, 255, 255),
    Text = Color3.fromRGB(235, 238, 245),
    TextDim = Color3.fromRGB(140, 145, 160),
    Accent = Color3.fromRGB(55, 100, 235),
    Stroke = Color3.fromRGB(45, 48, 65),
}

local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col or Theme.Stroke
    s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function padding(parent, p)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, p)
    pad.PaddingRight = UDim.new(0, p)
    pad.PaddingTop = UDim.new(0, p)
    pad.PaddingBottom = UDim.new(0, p)
    pad.Parent = parent
    return pad
end

-- ===== MAIN WINDOW =====
function UILibrary.new(config)
    config = config or {}
    local self = setmetatable({}, UILibrary)
    self._tabs = {}
    self._activeTab = nil
    self._visible = true
    self._toggleKey = config.ToggleKey or Enum.KeyCode.RightControl

    local player = Players.LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name = "UILibraryWindow"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = player:WaitForChild("PlayerGui")
    self._gui = gui

    -- Main window
    local main = Instance.new("Frame")
    main.Name = "MainWindow"
    main.Size = UDim2.new(0, config.Width or 600, 0, config.Height or 420)
    main.Position = UDim2.new(0.5, 0, 0.5, 0)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = Theme.Background
    main.BorderSizePixel = 0
    main.ClipsDescendants = true
    main.Parent = gui
    corner(main, 12)
    stroke(main, Theme.Stroke, 1.5)
    self._main = main

    -- Header
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 44)
    header.BackgroundColor3 = Theme.Header
    header.BorderSizePixel = 0
    header.Parent = main
    corner(header, 12)

    local headerFill = Instance.new("Frame")
    headerFill.Size = UDim2.new(1, 0, 0, 12)
    headerFill.Position = UDim2.new(0, 0, 1, -12)
    headerFill.BackgroundColor3 = Theme.Header
    headerFill.BorderSizePixel = 0
    headerFill.Parent = header

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -20, 1, 0)
    title.Position = UDim2.new(0, 16, 0, 0)
    title.BackgroundTransparency = 1
    title.Font = FONT
    title.TextColor3 = Theme.Text
    title.TextSize = 18
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Text = config.Title or "UI Library"
    title.Parent = header

    -- Tab bar (below header)
    local tabBar = Instance.new("Frame")
    tabBar.Name = "TabBar"
    tabBar.Size = UDim2.new(1, 0, 0, 36)
    tabBar.Position = UDim2.new(0, 0, 0, 44)
    tabBar.BackgroundColor3 = Theme.TabBar
    tabBar.BorderSizePixel = 0
    tabBar.Parent = main
    padding(tabBar, 8)

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0, 6)
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.Parent = tabBar
    self._tabBar = tabBar

    -- Content area (holds two side panels)
    local contentArea = Instance.new("Frame")
    contentArea.Name = "ContentArea"
    contentArea.Size = UDim2.new(1, 0, 1, -80)
    contentArea.Position = UDim2.new(0, 0, 0, 80)
    contentArea.BackgroundTransparency = 1
    contentArea.Parent = main
    self._contentArea = contentArea

    -- Toggle keybind
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self._toggleKey then
            self:ToggleWindow()
        end
    end)

    return self
end

-- ===== WINDOW TOGGLE =====
function UILibrary:ToggleWindow()
    self._visible = not self._visible
    local goal = self._visible and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, 0.5, 400)
    local tween = TweenService:Create(
        self._main,
        TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut),
        { Position = goal }
    )
    tween:Play()
    if not self._visible then
        task.wait(0.35)
        self._main.Visible = false
    else
        self._main.Visible = true
    end
end

-- ===== TAB CREATION =====
function UILibrary:CreateTab(name)
    local tab = {}
    tab._name = name
    tab._order = #self._tabs + 1

    -- Tab button
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 110, 0, 28)
    btn.BackgroundColor3 = Theme.TabInactive
    btn.BorderSizePixel = 0
    btn.Font = FONT
    btn.TextColor3 = Theme.TextDim
    btn.TextSize = 14
    btn.Text = name
    btn.AutoButtonColor = false
    btn.Parent = self._tabBar
    corner(btn, 6)
    tab._button = btn

    -- Tab page (holds left + right columns)
    local page = Instance.new("Frame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = self._contentArea
    tab._page = page

    -- Left side panel
    local leftPanel = Instance.new("ScrollingFrame")
    leftPanel.Name = "LeftSide"
    leftPanel.Size = UDim2.new(0.5, -6, 1, 0)
    leftPanel.Position = UDim2.new(0, 4, 0, 0)
    leftPanel.BackgroundTransparency = 1
    leftPanel.ScrollBarThickness = 3
    leftPanel.ScrollBarImageColor3 = Theme.Accent
    leftPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
    leftPanel.AutomaticCanvasSize = Enum.AutomaticSize.Y
    leftPanel.Parent = page
    padding(leftPanel, 4)
    local leftLayout = Instance.new("UIListLayout")
    leftLayout.Padding = UDim.new(0, 8)
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Parent = leftPanel
    tab._left = leftPanel
    tab._leftOrder = 0

    -- Right side panel
    local rightPanel = Instance.new("ScrollingFrame")
    rightPanel.Name = "RightSide"
    rightPanel.Size = UDim2.new(0.5, -6, 1, 0)
    rightPanel.Position = UDim2.new(0.5, 2, 0, 0)
    rightPanel.BackgroundTransparency = 1
    rightPanel.ScrollBarThickness = 3
    rightPanel.ScrollBarImageColor3 = Theme.Accent
    rightPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
    rightPanel.AutomaticCanvasSize = Enum.AutomaticSize.Y
    rightPanel.Parent = page
    padding(rightPanel, 4)
    local rightLayout = Instance.new("UIListLayout")
    rightLayout.Padding = UDim.new(0, 8)
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Parent = rightPanel
    tab._right = rightPanel
    tab._rightOrder = 0

    -- Section side panel backgrounds
    local leftBg = Instance.new("Frame")
    leftBg.Name = "LeftBg"
    leftBg.Size = UDim2.new(0.5, -6, 1, 0)
    leftBg.Position = UDim2.new(0, 4, 0, 0)
    leftBg.BackgroundColor3 = Theme.SidePanel
    leftBg.BorderSizePixel = 0
    leftBg.ZIndex = -1
    leftBg.Parent = page
    corner(leftBg, 8)
    stroke(leftBg, Theme.Stroke, 1)

    local rightBg = Instance.new("Frame")
    rightBg.Name = "RightBg"
    rightBg.Size = UDim2.new(0.5, -6, 1, 0)
    rightBg.Position = UDim2.new(0.5, 2, 0, 0)
    rightBg.BackgroundColor3 = Theme.SidePanel
    rightBg.BorderSizePixel = 0
    rightBg.ZIndex = -1
    rightBg.Parent = page
    corner(rightBg, 8)
    stroke(rightBg, Theme.Stroke, 1)

    -- Section labels
    local leftLabel = Instance.new("TextLabel")
    leftLabel.Name = "LeftLabel"
    leftLabel.Size = UDim2.new(1, 0, 0, 24)
    leftLabel.BackgroundTransparency = 1
    leftLabel.Font = FONT
    leftLabel.TextColor3 = Theme.TextDim
    leftLabel.TextSize = 12
    leftLabel.TextXAlignment = Enum.TextXAlignment.Center
    leftLabel.Text = "LEFT"
    leftLabel.Parent = leftPanel
    tab._leftLabel = leftLabel

    local rightLabel = Instance.new("TextLabel")
    rightLabel.Name = "RightLabel"
    rightLabel.Size = UDim2.new(1, 0, 0, 24)
    rightLabel.BackgroundTransparency = 1
    rightLabel.Font = FONT
    rightLabel.TextColor3 = Theme.TextDim
    rightLabel.TextSize = 12
    rightLabel.TextXAlignment = Enum.TextXAlignment.Center
    rightLabel.Text = "RIGHT"
    rightLabel.Parent = rightPanel
    tab._rightLabel = rightLabel

    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self._tabs, tab)

    if #self._tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

-- ===== TAB SELECTION =====
function UILibrary:SelectTab(tab)
    for _, t in self._tabs do
        t._page.Visible = false
        TweenService:Create(t._button, TweenInfo.new(0.2), { BackgroundColor3 = Theme.TabInactive, TextColor3 = Theme.TextDim }):Play()
    end

    self._activeTab = tab
    tab._page.Visible = true

    TweenService:Create(tab._button, TweenInfo.new(0.2), { BackgroundColor3 = Theme.TabActive, TextColor3 = Theme.Text }):Play()
end

-- ===== SET SECTION LABELS =====
function UILibrary:SetSectionLabels(tab, leftLabel, rightLabel)
    if tab._leftLabel and leftLabel then
        tab._leftLabel.Text = leftLabel
    end
    if tab._rightLabel and rightLabel then
        tab._rightLabel.Text = rightLabel
    end
end

-- ===== TOGGLE =====
local function createToggle(parent, order, label, default, callback)
    local toggled = default or false

    local frame = Instance.new("Frame")
    frame.Name = label .. "Toggle"
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = Theme.ComponentBg
    frame.BorderSizePixel = 0
    frame.LayoutOrder = order
    frame.Parent = parent
    corner(frame, 8)
    stroke(frame, Theme.Stroke, 1)
    padding(frame, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Name = "Label"
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = FONT
    lbl.TextColor3 = Theme.Text
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = label
    lbl.Parent = frame

    -- Switch background
    local switch = Instance.new("TextButton")
    switch.Name = "Switch"
    switch.Size = UDim2.new(0, 44, 0, 22)
    switch.Position = UDim2.new(1, -44, 0.5, -11)
    switch.BackgroundColor3 = toggled and Theme.ToggleOn or Theme.ToggleOff
    switch.BorderSizePixel = 0
    switch.Font = Enum.Font.SourceSans
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame
    corner(switch, 11)

    -- Knob
    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Theme.Knob
    knob.BorderSizePixel = 0
    knob.Parent = switch
    corner(knob, 8)

    local function update(animated)
        local knobPos = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local bgColor = toggled and Theme.ToggleOn or Theme.ToggleOff
        if animated then
            TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = knobPos }):Play()
            TweenService:Create(switch, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = bgColor }):Play()
        else
            knob.Position = knobPos
            switch.BackgroundColor3 = bgColor
        end
    end

    update(false)

    switch.MouseButton1Click:Connect(function()
        toggled = not toggled
        update(true)
        if callback then callback(toggled) end
    end)

    return {
        Set = function(val)
            toggled = val
            update(true)
            if callback then callback(toggled) end
        end,
        Get = function() return toggled end,
    }
end

function UILibrary:CreateToggle(tab, side, label, default, callback)
    if side == "left" then
        tab._leftOrder += 1
        return createToggle(tab._left, tab._leftOrder, label, default, callback)
    else
        tab._rightOrder += 1
        return createToggle(tab._right, tab._rightOrder, label, default, callback)
    end
end

return UILibrary
