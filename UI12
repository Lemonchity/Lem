                Library:Notify({Title = "Menu Keybind", Text = "Press any key on keyboard...", Duration = 3})
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Library.MenuKeybind = input.KeyCode
                        Library:Notify({Title = "Success", Text = "Menu key set to: " .. input.KeyCode.Name, Duration = 3})
                        conn:Disconnect()
                    end
                end)
            end
        })

        local bgToggle = ThemeCol:Toggle({Name = "Background Theme", Default = true})
        bgToggle.Add:Colorpicker({
            Default = Library.Theme.Background,
            Callback = function(col)
                Library.Theme.Background = col
                for _, obj in ipairs(Library.ThemeObjects.Background) do
                    if obj and obj.Parent then obj.BackgroundColor3 = col end
                end
            end
        })

        local txtToggle = ThemeCol:Toggle({Name = "Text Color", Default = true})
        txtToggle.Add:Colorpicker({
            Default = Library.Theme.Text,
            Callback = function(col)
                Library.Theme.Text = col
                for _, obj in ipairs(Library.ThemeObjects.Text) do
                    if obj and obj.Parent then obj.TextColor3 = col end
                end
            end
        })

        local accToggle = ThemeCol:Toggle({Name = "Snake Accent", Default = true})
        accToggle.Add:Colorpicker({
            Default = Library.Theme.Accent,
            Callback = function(col)
                Library.Theme.Accent = col
                CenterGlow.ImageColor3 = col
                for _, grad in ipairs(Library.ThemeObjects.Accent) do
                    if grad and grad.Parent then
                        grad.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, col),
                            ColorSequenceKeypoint.new(0.5, Library.Theme.Accent2),
                            ColorSequenceKeypoint.new(1, col)
                        })
                    end
                end
            end
        })

        local CfgCol = ConfTab:AddColumn({
            Name = "Config Manager",
            Description = "Save and load your JSON profiles",
            Side = 1
        })

        local function GetConfigList()
            local files = {}
            if isfolder and listfiles then
                if not isfolder(Library.FolderName) and makefolder then
                    makefolder(Library.FolderName)
                end
                local success, list = pcall(function() return listfiles(Library.FolderName) end)
                if success and type(list) == "table" then
                    for _, path in ipairs(list) do
                        local name = path:match("([^/\\]+)%.json$")
                        if name then
                            table.insert(files, name)
                        end
                    end
                end
            end
            if #files == 0 then
                table.insert(files, "default")
            end
            return files
        end

        local configName = "default"
        local initialConfigs = GetConfigList()
        local selectedConfig = initialConfigs[1]

        local ConfigDropdown = CfgCol:Dropdown({
            Name = "Saved Configs",
            Options = initialConfigs,
            Default = selectedConfig,
            Callback = function(opt)
                selectedConfig = opt
                configName = opt
            end
        })

        CfgCol:TextBox({
            Name = "New Config Name",
            Placeholder = "default",
            Callback = function(txt)
                if txt ~= "" then configName = txt end
            end
        })

        CfgCol:Button({
            Name = "Save Config",
            Callback = function()
                if writefile and makefolder then
                    if not isfolder(Library.FolderName) then makefolder(Library.FolderName) end
                    local data = {}
                    for k, v in pairs(Library.Flags) do
                        if typeof(v) ~= "Color3" then data[k] = v end
                    end
                    writefile(Library.FolderName .. "/" .. configName .. ".json", HttpService:JSONEncode(data))
                    ConfigDropdown:Refresh(GetConfigList(), configName)
                    selectedConfig = configName
                    Library:Notify({Title = "Config Saved", Text = "Saved '" .. configName .. "' successfully!", Duration = 3})
                else
                    Library:Notify({Title = "Error", Text = "Executor does not support writefile!", Duration = 3})
                end
            end
        })

        CfgCol:Button({
            Name = "Load Selected Config",
            Callback = function()
                if readfile and isfile then
                    local target = selectedConfig or configName
                    local path = Library.FolderName .. "/" .. target .. ".json"
                    if isfile(path) then
                        local decoded = HttpService:JSONDecode(readfile(path))
                        for k, v in pairs(decoded) do
                            Library.Flags[k] = v
                        end
                        Library:Notify({Title = "Config Loaded", Text = "Loaded '" .. target .. "'!", Duration = 3})
                    else
                        Library:Notify({Title = "Not Found", Text = "Config '" .. target .. "' does not exist.", Duration = 3})
                    end
                end
            end
        })

        CfgCol:Button({
            Name = "Refresh Config List",
            Callback = function()
                local updated = GetConfigList()
                ConfigDropdown:Refresh(updated, updated[1])
                selectedConfig = updated[1]
                Library:Notify({Title = "Refreshed", Text = "Config list updated.", Duration = 2})
            end
        })
    end

    return WindowObj
end

return Library
