-- СИСТЕМА НОТИФИКАЦИЙ (NOTIFY)
-- ==========================================
local ActiveNotifications = {}

function Library:Notify(options)
    local Title = options.Title or "Notification"
    local Text = options.Text or ""
    local Duration = options.Duration or 4

    -- Сдвигаем старые уведомления вниз
    for i, notif in ipairs(ActiveNotifications) do
        local targetY = 0.56 + (i * 0.085)
        Tween(notif, {Position = UDim2.new(0.5, 0, targetY, 0)}, 0.35, Enum.EasingStyle.Back)
    end

    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(0, 300, 0, 56)
    NotifFrame.AnchorPoint = Vector2.new(0.5, 0)
    NotifFrame.Position = UDim2.new(0.5, 0, 0.52, 0) -- Появление чуть ниже центра
    NotifFrame.BackgroundColor3 = Library.Theme.Background
    NotifFrame.BackgroundTransparency = 1
    NotifFrame.ClipsDescendants = true
    NotifFrame.Parent = ScreenGui

    local Corner = Instance.new("UICorner", NotifFrame)
    Corner.CornerRadius = UDim.new(0, 8)
    ApplySnakeStroke(NotifFrame, 1.5)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -16, 0, 20)
    TitleLabel.Position = UDim2.new(0, 8, 0, 4)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Font = Enum.Font.Arcade
    TitleLabel.TextSize = 15
    TitleLabel.TextColor3 = Library.Theme.Accent2
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Text = Title
    TitleLabel.Parent = NotifFrame

    local DescLabel = Instance.new("TextLabel")
    DescLabel.Size = UDim2.new(1, -16, 0, 24)
    DescLabel.Position = UDim2.new(0, 8, 0, 24)
    DescLabel.BackgroundTransparency = 1
    DescLabel.Font = Enum.Font.Arcade
    DescLabel.TextSize = 13
    DescLabel.TextColor3 = Library.Theme.Text
    DescLabel.TextXAlignment = Enum.TextXAlignment.Left
    DescLabel.Text = ""
    DescLabel.Parent = NotifFrame

    -- Линия таймера снизу
    local TimerBar = Instance.new("Frame")
    TimerBar.Size = UDim2.new(1, 0, 0, 3)
    TimerBar.Position = UDim2.new(0, 0, 1, -3)
    TimerBar.BackgroundColor3 = Library.Theme.Accent
    TimerBar.BorderSizePixel = 0
    TimerBar.Parent = NotifFrame

    table.insert(ActiveNotifications, 1, NotifFrame)

    -- Анимация появления
    Tween(NotifFrame, {Position = UDim2.new(0.5, 0, 0.56, 0), BackgroundTransparency = 0.05}, 0.35, Enum.EasingStyle.Back)

    -- Эффект печатанья (Typewriter)
    task.spawn(function()
        for i = 1, #Text do
            if not DescLabel.Parent then break end
            DescLabel.Text = string.sub(Text, 1, i)
            task.wait(0.025)
        end
    end)

    -- Анимация линии времени
    local timerTween = Tween(TimerBar, {Size = UDim2.new(0, 0, 0, 3)}, Duration, Enum.EasingStyle.Linear)
    timerTween.Completed:Connect(function()
        local idx = table.find(ActiveNotifications, NotifFrame)
        if idx then table.remove(ActiveNotifications, idx) end

        -- Возвращаем оставшиеся наверх
        for i, notif in ipairs(ActiveNotifications) do
            local targetY = 0.56 + ((i - 1) * 0.085)
            Tween(notif, {Position = UDim2.new(0.5, 0, targetY, 0)}, 0.3)
        end

        local out = Tween(NotifFrame, {BackgroundTransparency = 1, Position = NotifFrame.Position + UDim2.new(0, 0, 0.03, 0)}, 0.25)
        out.Completed:Wait()
        NotifFrame:Destroy()
    end)
end

