    local IconId = options.Icon or "rbxassetid://7733960981"
    local ToggleIconId = options.MobileIcon or "rbxassetid://7733960981"
    Library.MenuKeybind = options.Keybind or Enum.KeyCode.RightControl

    -- Мобильная кнопка открытия/закрытия UI
