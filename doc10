local Create = Library.Create
local Add = Library.Add

Add:Watermark({ — watermark
    Text = "Made By AI",
    Icon = "rbxassetid://123456"
})

-- 2. Создаем увеличенное окно с иконкой в TopBar
local Window = Create:Window({
    Name = "Lol",
    Subtitle = "ByAI",
    Keybind = Enum.KeyCode.RightControl,
    Icon = "rbxassetid://123456" -- Кастомная иконка справа
})

-- 3. Добавляем Вкладки (с тултипами при наведении)
local Tab1 = Window.Add:Tab({
    Name = "Main",
    Tooltip = "Main combat & movement settings"
})

local Tab2 = Window.Add:Tab({
    Name = "Visuals",
    Tooltip = "ESP and render configs"
})

-- 4. Добавляем Колонки (Side = 1 — слева, Side = 2 — справа)
local LeftCol = Tab1.Add:Column({
    Name = "Farming",
    Description = "Auto actions",
    Side = 1
})

local RightCol = Tab1.Add:Column({
    Name = "Player Stats",
    Description = "Speed and Jump",
    Side = 2
})

-- 5. Тоггл с привязкой синего RGB-колорпикера и кейбинда
local Toggle1 = LeftCol.Create:Toggle({
    Name = "Auto Attack",
    Default = false,
    Callback = function(val)
        print("Auto Attack:", val)
    end
})

-- Синее меню RGB слайдеров открывается кликом на квадратик цвета
Toggle1.add:Colorpicker({
    Default = Color3.fromRGB(0, 180, 255),
    Callback = function(color)
        print("New RGB:", color)
    end
})

Toggle1.add:Keybind({
    Default = Enum.KeyCode.F,
    Callback = function(key)
        print("Toggled by Key:", key.Name)
    end
})

-- 6. Добавление Слайдера в правую колонку
RightCol.Add:Slider({
    Name = "WalkSpeed",
    Min = 16,
    Max = 120,
    Default = 32,
    Callback = function(v)
        print("WalkSpeed:", v)
    end
})

-- 7. Дропдаун
RightCol.Add:Dropdown({
    Name = "Target Mode",
    List = {"Closest", "Lowest HP", "Players Only"},
    Callback = function(choice)
        print("Selected Mode:", choice)
    end
})

-- 8. Проверка уведомлений
Library:Notify({
    Title = "SUCCESS",
    Text = "All arcade components loaded!",
    Duration = 4
})