                    local CPTitle = Instance.new("TextLabel")
                    CPTitle.Size = UDim2.new(1, -10, 0, 18)
                    CPTitle.Position = UDim2.new(0, 8, 0, 3)
                    CPTitle.Font = FONT
                    CPTitle.Text = "RGB COLOR"
                    CPTitle.TextColor3 = Color3.fromRGB(130, 215, 255)
                    CPTitle.TextSize = 11
                    CPTitle.TextXAlignment = Enum.TextXAlignment.Left
                    CPTitle.BackgroundTransparency = 1
                    CPTitle.ZIndex = 5001
                    CPTitle.Parent = CPModal

                    local rVal = math.floor(curColor.R * 255)
                    local gVal = math.floor(curColor.G * 255)
                    local bVal = math.floor(curColor.B * 255)

                    local function makeRGBSlider(name, col3, defVal, yOffset, onChange)
                        local sFrame = Instance.new("Frame")
                        sFrame.Size = UDim2.new(1, -12, 0, 22)
                        sFrame.Position = UDim2.new(0, 6, 0, yOffset)
                        sFrame.BackgroundTransparency = 1
                        sFrame.ZIndex = 5001
                        sFrame.Parent = CPModal

                        local sLbl = Instance.new("TextLabel")
                        sLbl.Size = UDim2.new(0, 16, 1, 0)
                        sLbl.Font = FONT
                        sLbl.Text = name
                        sLbl.TextColor3 = col3
                        sLbl.TextSize = 11
                        sLbl.BackgroundTransparency = 1
                        sLbl.ZIndex = 5002
                        sLbl.Parent = sFrame

                        local bar = Instance.new("TextButton")
                        bar.Size = UDim2.new(1, -45, 0, 8)
                        bar.Position = UDim2.new(0, 20, 0.5, -4)
                        bar.BackgroundColor3 = Color3.fromRGB(24, 38, 65)
                        bar.Text = ""
                        bar.AutoButtonColor = false
                        bar.ZIndex = 5002
                        bar.Parent = sFrame

                        local barCorner = Instance.new("UICorner")
                        barCorner.CornerRadius = UDim.new(0, 3)
                        barCorner.Parent = bar

                        local fill = Instance.new("Frame")
                        fill.Size = UDim2.new(defVal / 255, 0, 1, 0)
                        fill.BackgroundColor3 = col3
                        fill.BorderSizePixel = 0
                        fill.ZIndex = 5003
                        fill.Parent = bar

                        local numLbl = Instance.new("TextLabel")
                        numLbl.Size = UDim2.new(0, 24, 1, 0)
                        numLbl.Position = UDim2.new(1, -22, 0, 0)
                        numLbl.Font = FONT
                        numLbl.Text = tostring(defVal)
                        numLbl.TextColor3 = Color3.fromRGB(210, 210, 210)
                        numLbl.TextSize = 10
                        numLbl.BackgroundTransparency = 1
                        numLbl.ZIndex = 5002
                        numLbl.Parent = sFrame

                        local dragging = false
                        local function updateSlider(input)
                            local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                            local val = math.floor(pct * 255)
                            fill.Size = UDim2.new(pct, 0, 1, 0)
                            numLbl.Text = tostring(val)
                            onChange(val)
                        end

                        bar.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                dragging = true
                                updateSlider(input)
                            end
                        end)

                        UserInputService.InputEnded:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                                dragging = false
                            end
                        end)

                        UserInputService.InputChanged:Connect(function(input)
                            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                                updateSlider(input)
                            end
                        end)
                    end

                    local function applyRGB()
                        curColor = Color3.fromRGB(rVal, gVal, bVal)
                        CPButton.BackgroundColor3 = curColor
                        pcall(cpCallback, curColor)
                    end

                    makeRGBSlider("R", Color3.fromRGB(255, 80, 80), rVal, 24, function(v) rVal = v applyRGB() end)
                    makeRGBSlider("G", Color3.fromRGB(80, 255, 80), gVal, 50, function(v) gVal = v applyRGB() end)
                    makeRGBSlider("B", Color3.fromRGB(80, 180, 255), bVal, 76, function(v) bVal = v applyRGB() end)

                    local function repositionModal()
                        local btnPos = CPButton.AbsolutePosition
                        local btnSize = CPButton.AbsoluteSize
                        CPModal.Position = UDim2.new(0, btnPos.X + btnSize.X + 8, 0, btnPos.Y - 10)
                    end

                    CPButton.MouseButton1Click:Connect(function()
                        repositionModal()
                        CPModal.Visible = not CPModal.Visible
                    end)

                    CPButton:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
                        if CPModal.Visible then
                            repositionModal()
                        end
                    end)

                    ToggleFrame.Destroying:Connect(function()
                        CPModal:Destroy()
                    end)
                end

                ToggleObj.AddKeybind = attachKeybind
                ToggleObj.add.Keybind = attachKeybind
                ToggleObj.add.keybind = attachKeybind

                ToggleObj.AddColorpicker = attachColorpicker
                ToggleObj.add.Colorpicker = attachColorpicker
                ToggleObj.add.colorpicker = attachColorpicker

                return ToggleObj
            end

            -- Слайдер
            function ColumnObject:Slider(sCfg)
                local sName = sCfg.Name or "Slider"
                local min = sCfg.Min or 0
                local max = sCfg.Max or 100
                local default = sCfg.Default or min
                local callback = sCfg.Callback or function() end

                local SliderFrame = Instance.new("Frame")
                SliderFrame.Size = UDim2.new(1, 0, 0, 42)
                SliderFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
                SliderFrame.BorderSizePixel = 0
                SliderFrame.Parent = ItemList

                local SFC = Instance.new("UICorner")
                SFC.CornerRadius = UDim.new(0, 4)
                SFC.Parent = SliderFrame

                local Title = Instance.new("TextLabel")
                Title.Size = UDim2.new(0.7, 0, 0, 18)
                Title.Position = UDim2.new(0, 8, 0, 2)
                Title.Font = FONT
                Title.Text = sName
                Title.TextColor3 = Color3.fromRGB(220, 220, 220)
                Title.TextSize = 12
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.BackgroundTransparency = 1
                Title.Parent = SliderFrame

                local ValLabel = Instance.new("TextLabel")
                ValLabel.Size = UDim2.new(0.3, -8, 0, 18)
                ValLabel.Position = UDim2.new(0.7, 0, 0, 2)
                ValLabel.Font = FONT
                ValLabel.Text = tostring(default)
                ValLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
                ValLabel.TextSize = 12
                ValLabel.TextXAlignment = Enum.TextXAlignment.Right
                ValLabel.BackgroundTransparency = 1
                ValLabel.Parent = SliderFrame

                local BarBack = Instance.new("TextButton")
                BarBack.Size = UDim2.new(1, -16, 0, 8)
                BarBack.Position = UDim2.new(0, 8, 0, 25)
                BarBack.BackgroundColor3 = Color3.fromRGB(44, 44, 56)
                BarBack.BorderSizePixel = 0
                BarBack.Text = ""
                BarBack.AutoButtonColor = false
                BarBack.Parent = SliderFrame

                local BarFill = Instance.new("Frame")
                local startScale = math.clamp((default - min) / (max - min), 0, 1)
                BarFill.Size = UDim2.new(startScale, 0, 1, 0)
                BarFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
                BarFill.BorderSizePixel = 0
                BarFill.Parent = BarBack

                local dragging = false
                local function update(input)
                    local posX = input.Position.X - BarBack.AbsolutePosition.X
                    local pct = math.clamp(posX / BarBack.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + ((max - min) * pct))

                    BarFill.Size = UDim2.new(pct, 0, 1, 0)
                    ValLabel.Text = tostring(val)
                    pcall(callback, val)
                end

                BarBack.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        update(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input)
                    end
                end)
            end

            -- Дропдаун
            function ColumnObject:Dropdown(dCfg)
                local dName = dCfg.Name or "Dropdown"
                local list = dCfg.List or {}
                local callback = dCfg.Callback or function() end

                local DropFrame = Instance.new("Frame")
                DropFrame.Size = UDim2.new(1, 0, 0, 32)
                DropFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
                DropFrame.BorderSizePixel = 0
                DropFrame.ClipsDescendants = true
                DropFrame.Parent = ItemList

                local DFC = Instance.new("UICorner")
                DFC.CornerRadius = UDim.new(0, 4)
                DFC.Parent = DropFrame

                local DropBtn = Instance.new("TextButton")
                DropBtn.Size = UDim2.new(1, 0, 0, 32)
                DropBtn.BackgroundTransparency = 1
                DropBtn.Font = FONT
                DropBtn.Text = "  " .. dName .. " >"
                DropBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
                DropBtn.TextSize = 12
                DropBtn.TextXAlignment = Enum.TextXAlignment.Left
                DropBtn.Parent = DropFrame

                local DropContainer = Instance.new("Frame")
                DropContainer.Size = UDim2.new(1, -10, 0, #list * 22)
                DropContainer.Position = UDim2.new(0, 5, 0, 32)
                DropContainer.BackgroundTransparency = 1
                DropContainer.Parent = DropFrame

                local ListLayout = Instance.new("UIListLayout")
                ListLayout.Padding = UDim.new(0, 2)
                ListLayout.Parent = DropContainer

                local opened = false

                for _, item in ipairs(list) do
                    local itemBtn = Instance.new("TextButton")
                    itemBtn.Size = UDim2.new(1, 0, 0, 20)
                    itemBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
                    itemBtn.Font = FONT
                    itemBtn.Text = tostring(item)
                    itemBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
                    itemBtn.TextSize = 11
                    itemBtn.BorderSizePixel = 0
                    itemBtn.Parent = DropContainer

                    itemBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = "  " .. dName .. ": " .. tostring(item)
                        opened = false
                        DropFrame.Size = UDim2.new(1, 0, 0, 32)
                        pcall(callback, item)
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    DropFrame.Size = opened and UDim2.new(1, 0, 0, 34 + (#list * 24)) or UDim2.new(1, 0, 0, 32)
                end)
            end

            ColumnObject.Create.Toggle = function(_, cfg) return ColumnObject:Toggle(cfg) end
            ColumnObject.Create.toggle = ColumnObject.Create.Toggle
            ColumnObject.Add.Toggle = ColumnObject.Create.Toggle

            ColumnObject.Add.Slider = function(_, cfg) return ColumnObject:Slider(cfg) end
            ColumnObject.Create.Slider = ColumnObject.Add.Slider

            ColumnObject.Add.Dropdown = function(_, cfg) return ColumnObject:Dropdown(cfg) end
            ColumnObject.Create.Dropdown = ColumnObject.Add.Dropdown

            return ColumnObject
        end

        TabObject.Add.Column = function(_, cfg) return TabObject:Column(cfg) end
        TabObject.Add.column = TabObject.Add.Column
        TabObject.Create.Column = TabObject.Add.Column

        return TabObject
    end

    WindowHandler.Add.Tab = function(_, cfg) return WindowHandler:Tab(cfg) end
    WindowHandler.Add.tab = WindowHandler.Add.Tab
    WindowHandler.Create.Tab = WindowHandler.Add.Tab

    return WindowHandler
end

Library.Create = {
