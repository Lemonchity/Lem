    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -12, 0, 24)
    msgLabel.Position = UDim2.new(0, 8, 0, 20)
    msgLabel.Font = FONT
    msgLabel.Text = ""
    msgLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    msgLabel.TextSize = 12
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.BackgroundTransparency = 1
    msgLabel.ZIndex = 3002
    msgLabel.Parent = card

    local progressTrack = Instance.new("Frame")
    progressTrack.Size = UDim2.new(1, 0, 0, 3)
    progressTrack.Position = UDim2.new(0, 0, 1, -3)
    progressTrack.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    progressTrack.BorderSizePixel = 0
    progressTrack.ZIndex = 3002
    progressTrack.Parent = card

    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(1, 0, 1, 0)
    progressBar.BackgroundColor3 = Color3.fromRGB(0, 255, 170)
    progressBar.BorderSizePixel = 0
