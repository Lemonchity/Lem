-- Привязка колорпикера к имени тоггла: Linkcolorpicker:Имятоггла
function Library:LinkColorPicker(page, toggleName, defaultColor, onColorChanged)
    local toggleFrame = page:FindFirstChild("Toggle_" .. toggleName)
    if not toggleFrame then
        warn("Тоггл с именем " .. toggleName .. " не найден!")
        return
    end

    local rightContainer = toggleFrame:FindFirstChild("RightComponents")
    if not rightContainer then return end

    local colorPickerBtn = Instance.new("TextButton")
    colorPickerBtn.Name = "Linkcolorpicker:" .. toggleName
    colorPickerBtn.Size = UDim2.new(0, 20, 0, 20)
    colorPickerBtn.BackgroundColor3 = defaultColor or Color3.fromRGB(255, 0, 128)
    colorPickerBtn.Text = ""
    colorPickerBtn.AutoButtonColor = false
    colorPickerBtn.LayoutOrder = 1 -- Встает левее свитчера
    colorPickerBtn.Parent = rightContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = colorPickerBtn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(255, 255, 255)
    btnStroke.Transparency = 0.7
    btnStroke.Parent = colorPickerBtn

    colorPickerBtn.MouseButton1Click:Connect(function()
        -- Вызов диалога выбора цвета
        if onColorChanged then
            onColorChanged(colorPickerBtn.BackgroundColor3)
        end
    end)

    return colorPickerBtn
end

        function col:AddSlider(text, min, max, default, callback)
            callback = callback or function() end
            min, max = min or 0, max or 100
            local value = default or min

            local sliderFrame = Instance.new("Frame")
            sliderFrame.Size = UDim2.new(1, 0, 0, 48)
            sliderFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            sliderFrame.Parent = self.Holder

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = sliderFrame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0.7, 0, 0, 20)
            label.Position = UDim2.new(0, 10, 0, 4)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(230, 230, 230)
            label.Font = ARCADE_FONT
            label.TextSize = 15
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = sliderFrame

            local valLabel = Instance.new("TextLabel")
            valLabel.Size = UDim2.new(0.3, -20, 0, 20)
            valLabel.Position = UDim2.new(0.7, 0, 0, 4)
            valLabel.BackgroundTransparency = 1
            valLabel.Text = tostring(value)
            valLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
            valLabel.Font = ARCADE_FONT
            valLabel.TextSize = 14
            valLabel.TextXAlignment = Enum.TextXAlignment.Right
            valLabel.Parent = sliderFrame

            local barBg = Instance.new("Frame")
            barBg.Size = UDim2.new(1, -20, 0, 6)
            barBg.Position = UDim2.new(0, 10, 0, 30)
            barBg.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            barBg.Parent = sliderFrame

            local barCorner = Instance.new("UICorner")
            barCorner.CornerRadius = UDim.new(1, 0)
            barCorner.Parent = barBg

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            fill.BorderSizePixel = 0
            fill.Parent = barBg

            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill

            local isSliding = false
            local function update(input)
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                value = math.floor(min + ((max - min) * pos))
                valLabel.Text = tostring(value)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                callback(value)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isSliding = true
                    update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isSliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update(input)
                end
            end)
        end

        function col:AddDropdown(text, list, callback)
            callback = callback or function() end
            local dropped = false

            local ddFrame = Instance.new("Frame")
            ddFrame.Size = UDim2.new(1, 0, 0, 34)
            ddFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            ddFrame.ClipsDescendants = true
            ddFrame.Parent = self.Holder

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = ddFrame

            local mainBtn = Instance.new("TextButton")
            mainBtn.Size = UDim2.new(1, 0, 0, 34)
            mainBtn.BackgroundTransparency = 1
            mainBtn.Text = text .. " >"
            mainBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
            mainBtn.Font = ARCADE_FONT
            mainBtn.TextSize = 15
            mainBtn.Parent = ddFrame

            local ddLayout = Instance.new("UIListLayout")
            ddLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ddLayout.Parent = ddFrame

            mainBtn.MouseButton1Click:Connect(function()
                dropped = not dropped
                local targetHeight = dropped and (34 + (#list * 28) + 4) or 34
                TweenService:Create(ddFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            end)

            for _, item in ipairs(list) do
                local itemBtn = Instance.new("TextButton")
                itemBtn.Size = UDim2.new(1, 0, 0, 28)
                itemBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
                itemBtn.Text = tostring(item)
                itemBtn.TextColor3 = Color3.fromRGB(190, 190, 210)
                itemBtn.Font = ARCADE_FONT
                itemBtn.TextSize = 14
                itemBtn.BorderSizePixel = 0
                itemBtn.Parent = ddFrame

                itemBtn.MouseButton1Click:Connect(function()
                    mainBtn.Text = text .. ": " .. tostring(item)
                    dropped = false
                    TweenService:Create(ddFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 34)}):Play()
                    callback(item)
                end)
            end
        end

        function col:AddTextBox(titleText, placeholder, clearOnFocus, callback)
            callback = callback or function() end
            clearOnFocus = (clearOnFocus == nil) and true or clearOnFocus

            local tbContainer = Instance.new("Frame")
            tbContainer.Size = UDim2.new(1, 0, 0, 52)
            tbContainer.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            tbContainer.Parent = self.Holder

            local contCorner = Instance.new("UICorner")
            contCorner.CornerRadius = UDim.new(0, 6)
            contCorner.Parent = tbContainer

            local tbTitle = Instance.new("TextLabel")
            tbTitle.Size = UDim2.new(1, -16, 0, 18)
            tbTitle.Position = UDim2.new(0, 8, 0, 4)
            tbTitle.BackgroundTransparency = 1
            tbTitle.Text = string.upper(titleText or "INPUT")
            tbTitle.TextColor3 = Color3.fromRGB(200, 200, 220)
            tbTitle.Font = ARCADE_FONT
            tbTitle.TextSize = 14
            tbTitle.TextXAlignment = Enum.TextXAlignment.Left
            tbTitle.Parent = tbContainer

            local boxInput = Instance.new("TextBox")
            boxInput.Size = UDim2.new(1, -16, 0, 24)
            boxInput.Position = UDim2.new(0, 8, 0, 22)
            boxInput.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            boxInput.TextColor3 = Color3.fromRGB(255, 255, 255)
            boxInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
            boxInput.PlaceholderText = placeholder or "Введите текст..."
            boxInput.Text = ""
            boxInput.Font = ARCADE_FONT
            boxInput.TextSize = 14
            boxInput.ClearTextOnFocus = clearOnFocus
            boxInput.BorderSizePixel = 0
            boxInput.Parent = tbContainer

            local boxCorner = Instance.new("UICorner")
            boxCorner.CornerRadius = UDim.new(0, 4)
            boxCorner.Parent = boxInput

            local boxStroke = Instance.new("UIStroke")
            boxStroke.Thickness = 1
            boxStroke.Color = Color3.fromRGB(50, 50, 65)
            boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            boxStroke.Parent = boxInput

            boxInput.Focused:Connect(function()
                TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 255)}):Play()
            end)

            boxInput.FocusLost:Connect(function(enterPressed)
                TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 50, 65)}):Play()
                if enterPressed then
                    callback(boxInput.Text)
                end
            end)

            return boxInput
        end

        return col
    end

    return tab
end

return Library
