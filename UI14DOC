local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/ТВОЙ_НИК/РЕПО/main/Library.lua"))()

local Create = Library.Create
local Add = Library.Add
local add = Library.add
local Esp = Library.Esp
local Addconftab = Library.Addconftab

-- Создаем окно
local Window = Create:Window({
    Name = "klax",
    Subtitle = "ByAI",
    Logo = "rbxassetid://7733960981",
    Keybind = Enum.KeyCode.RightControl
})

-- Ватермарк
Library:CreateWatermark({
    Logo = "rbxassetid://7733960981",
    Prefix = "klax | LeMOON",
    DynamicFPS = true
})

-- Вкладки и Pages
local MainTab = Window:Tab({ Name = "Main" })
local Page1 = MainTab:Page({ Name = "Page 1" })
local Page2 = MainTab:Page({ Name = "Page 2" })

local LeftSec = Page1:Section({ Name = "Player", Side = "Left" })
local Toggle1 = Create:Toggle(LeftSec, {
    Name = "Speed Hack",
    Default = false,
    Flag = "speed_enabled",
    Callback = function(state)
        print("Speed:", state)
    end
})
add:Colorpicker(Toggle1, { Default = Color3.fromRGB(0, 255, 150), Flag = "speed_col" })
add:Keybind(Toggle1, { Default = Enum.KeyCode.LeftShift, Mode = "Hold", Flag = "speed_bind" })

Add:Slider(LeftSec, {
    Name = "WalkSpeed",
    Min = 16,
    Max = 150,
    Default = 25,
    Flag = "walkspeed_val"
})

-- Готовая вкладка ESP с 3D Preview
Window:Esp("Visuals")

-- Готовая вкладка Settings (JSON-конфиги и настройка цветов)
Addconftab(Window)

-- Нотификация
Library:Notify({
    Title = "LeMOON",
    Text = "Library loaded via loadstring!",
    Duration = 4
})